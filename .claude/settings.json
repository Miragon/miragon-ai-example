{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BPMN_KEEP_FLOW_IDS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(npm run lint:bpmn)",
      "Bash(npm --prefix frontend run *)",
      "Bash(npx --yes @miragon/design-iq-validator@5.3.0 *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Edit(/service/app/src/main/kotlin/io/miragon/blueprint/adapter/process/BikeLeasingProcessProcessApi.kt)",
      "Edit(/service/app/src/main/kotlin/io/miragon/blueprint/adapter/process/ServiceTasks.kt)",
      "Edit(/service/app/src/main/kotlin/io/miragon/blueprint/adapter/process/Messages.kt)",
      "Edit(/service/app/src/main/kotlin/io/miragon/blueprint/adapter/process/ProcessVariables.kt)",
      "Edit(/service/app/src/main/kotlin/io/miragon/blueprint/adapter/process/Errors.kt)",
      "Edit(/service/app/src/main/kotlin/io/miragon/blueprint/adapter/process/Escalations.kt)",
      "Edit(/openapi/openapi.json)",
      "Edit(/frontend/src/shared/api/generated/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-env-files.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-bpmn.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "miragon-bpmn": {
      "source": {
        "source": "github",
        "repo": "Miragon/bpmn-cli",
        "ref": "v0.7.0"
      }
    },
    "miragon": {
      "source": {
        "source": "github",
        "repo": "Miragon/operate",
        "ref": "v0.9.0"
      }
    },
    "bpmn-to-code": {
      "source": {
        "source": "github",
        "repo": "Miragon/bpmn-to-code",
        "ref": "v6.3.0"
      }
    },
    "miragon-bpmnlint": {
      "source": {
        "source": "github",
        "repo": "Miragon/bpmnlint-rules",
        "ref": "v0.14.0"
      }
    }
  },
  "enabledPlugins": {
    "bpmn-cli@miragon-bpmn": true,
    "operate@miragon": true,
    "bpmn-to-code@bpmn-to-code": true,
    "bpmnlint-rules@miragon-bpmnlint": true
  }
}
