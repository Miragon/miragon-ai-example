{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "MiraVelo Bike-Leasing API",
    "description" : "Endpoints that drive the MiraVelo bike-leasing process: submit and list applications, sign the contract, report the handover, withdraw, and work the back-office inbox (credit check, reversal). The engine-internal /engine-rest API is intentionally excluded.",
    "version" : "1.0"
  },
  "paths" : {
    "/api/bike-leasing" : {
      "get" : {
        "tags" : [ "list-leasing-applications-controller" ],
        "operationId" : "listLeasingApplications",
        "parameters" : [ {
          "name" : "status",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "RECEIVED", "CONTRACT_SENT", "ORDERED", "ACTIVE", "REJECTED", "WITHDRAWN", "CANCELLED" ]
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "A page of leasing applications, newest first",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LeasingApplicationPageDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid paging parameters",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "submit-leasing-request-controller" ],
        "operationId" : "submitLeasingRequest",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LeasingRequestInput"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "The id of the new leasing application",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LeasingApplicationCreatedDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid request, for example no income",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/bike-leasing/{applicationId}/withdraw" : {
      "post" : {
        "tags" : [ "withdraw-application-controller" ],
        "operationId" : "withdrawApplication",
        "parameters" : [ {
          "name" : "applicationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "Accepted: the back office reverses the application"
          },
          "400" : {
            "description" : "Invalid application id",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "The case is already finished or withdrawn",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/bike-leasing/{applicationId}/sign-contract" : {
      "post" : {
        "tags" : [ "sign-contract-controller" ],
        "operationId" : "signContract",
        "parameters" : [ {
          "name" : "applicationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "Accepted: the process continues asynchronously"
          },
          "400" : {
            "description" : "Invalid application id",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "The case is not waiting for a signature",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/bike-leasing/{applicationId}/reversal" : {
      "post" : {
        "tags" : [ "complete-reversal-controller" ],
        "operationId" : "completeReversal",
        "parameters" : [ {
          "name" : "applicationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "Accepted: the task is completed, the process continues asynchronously"
          },
          "400" : {
            "description" : "Invalid application id",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown application, or no open reversal",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/bike-leasing/{applicationId}/report-handover" : {
      "post" : {
        "tags" : [ "report-handover-controller" ],
        "operationId" : "reportHandover",
        "parameters" : [ {
          "name" : "applicationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "Accepted: the process continues asynchronously"
          },
          "400" : {
            "description" : "Invalid application id",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "The case is not waiting for the handover",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/bike-leasing/{applicationId}/credit-check" : {
      "post" : {
        "tags" : [ "complete-credit-check-controller" ],
        "operationId" : "completeCreditCheck",
        "parameters" : [ {
          "name" : "applicationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreditCheckInput"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted: the task is completed, the process continues asynchronously"
          },
          "400" : {
            "description" : "Invalid application id",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown application, or no open credit check",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks" : {
      "get" : {
        "tags" : [ "list-open-tasks-controller" ],
        "operationId" : "listOpenTasks",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/OpenTaskDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bikes" : {
      "get" : {
        "tags" : [ "list-bikes-controller" ],
        "operationId" : "listBikes",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/BikeDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bike-leasing/{applicationId}" : {
      "get" : {
        "tags" : [ "get-leasing-application-controller" ],
        "operationId" : "getLeasingApplication",
        "parameters" : [ {
          "name" : "applicationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The leasing application",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LeasingApplicationDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid application id",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown application (no body)"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "BikeDto" : {
        "type" : "object",
        "properties" : {
          "bikeId" : {
            "type" : "string"
          },
          "model" : {
            "type" : "string"
          }
        },
        "required" : [ "bikeId", "model" ]
      },
      "CreditCheckInput" : {
        "type" : "object",
        "properties" : {
          "solvent" : {
            "type" : "boolean"
          }
        },
        "required" : [ "solvent" ]
      },
      "LeasingApplicationCreatedDto" : {
        "type" : "object",
        "properties" : {
          "applicationId" : {
            "type" : "string"
          }
        },
        "required" : [ "applicationId" ]
      },
      "LeasingApplicationDto" : {
        "type" : "object",
        "properties" : {
          "applicationId" : {
            "type" : "string"
          },
          "customerName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "age" : {
            "type" : "integer",
            "format" : "int32"
          },
          "monthlyNetIncome" : {
            "type" : "number",
            "format" : "double"
          },
          "bikeId" : {
            "type" : "string"
          },
          "bikeModel" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "type" : "string",
            "enum" : [ "RECEIVED", "CONTRACT_SENT", "ORDERED", "ACTIVE", "REJECTED", "WITHDRAWN", "CANCELLED" ]
          },
          "contractId" : {
            "type" : [ "string", "null" ]
          },
          "orderId" : {
            "type" : [ "string", "null" ]
          },
          "policyId" : {
            "type" : [ "string", "null" ]
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "age", "applicationId", "bikeId", "createdAt", "customerName", "email", "monthlyNetIncome", "status" ]
      },
      "LeasingApplicationPageDto" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LeasingApplicationDto"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "items", "page", "size", "totalElements", "totalPages" ]
      },
      "LeasingRequestInput" : {
        "type" : "object",
        "properties" : {
          "customerName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "age" : {
            "type" : "integer",
            "format" : "int32"
          },
          "monthlyNetIncome" : {
            "type" : "number",
            "format" : "double"
          },
          "bikeId" : {
            "type" : "string"
          }
        },
        "required" : [ "age", "bikeId", "customerName", "email", "monthlyNetIncome" ]
      },
      "OpenTaskDto" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "enum" : [ "CREDIT_CHECK", "REVERSAL" ]
          },
          "waitingSince" : {
            "type" : "string",
            "format" : "date-time"
          },
          "application" : {
            "$ref" : "#/components/schemas/LeasingApplicationDto"
          }
        },
        "required" : [ "application", "type", "waitingSince" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      }
    }
  }
}
