<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmiq="https://bpmiq.io/schema/1.0/bpmiq" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="fmap_definitions_bikeLeasing" targetNamespace="http://miragon.io/miravelo/bike-leasing/feature-map" bpmiq:mode="workshop">
  <bpmn:collaboration id="fmap_collaboration_bikeLeasing">
    <bpmn:participant id="fmap_participant_bikeLeasing" name="Bike leasing — feature map" processRef="fmap_process_bikeLeasing" />
    <bpmn:group id="fmap_group_coreApply" categoryValueRef="fmap_cv_coreApply" />
    <bpmn:group id="fmap_group_coreContract" categoryValueRef="fmap_cv_coreContract" />
    <bpmn:group id="fmap_group_coreReject" categoryValueRef="fmap_cv_coreReject" />
    <bpmn:group id="fmap_group_coreInsureOrder" categoryValueRef="fmap_cv_coreInsureOrder" />
    <bpmn:group id="fmap_group_coreActivate" categoryValueRef="fmap_cv_coreActivate" />
    <bpmn:group id="fmap_group_coreWithdraw" categoryValueRef="fmap_cv_coreWithdraw" />
    <bpmn:group id="fmap_group_f1Reminder" categoryValueRef="fmap_cv_f1Reminder" />
    <bpmn:group id="fmap_group_f18SignatureDeadline" categoryValueRef="fmap_cv_f18SignatureDeadline" />
    <bpmn:group id="fmap_group_f20AlternativeBike" categoryValueRef="fmap_cv_f20AlternativeBike" />
    <bpmn:group id="fmap_group_f21WithdrawalPeriod" categoryValueRef="fmap_cv_f21WithdrawalPeriod" />
    <bpmn:group id="fmap_group_f3AutomaticReversal" categoryValueRef="fmap_cv_f3AutomaticReversal" />
    <bpmn:group id="fmap_group_f4OrderCancellation" categoryValueRef="fmap_cv_f4OrderCancellation" />
  </bpmn:collaboration>
  <bpmn:process id="fmap_process_bikeLeasing" name="Bike leasing — feature map" isExecutable="false">
    <bpmn:extensionElements>
      <bpmiq:sticky id="fmap_sticky_f11Decided" text="#11 decided (ADR-0010): both human tasks are in the frontend inbox" x="175" y="362" kind="note" width="230" height="56" />
      <bpmiq:sticky id="fmap_sticky_f19CreditCheckDmn" text="#19 Credit check by DMN (Stage 2)" x="440" y="362" kind="note" width="160" height="56" />
      <bpmiq:sticky id="fmap_sticky_f1Shorthand" text="Shorthand: 7 days after sending. Executable: a timer on the receive task Contract signed." x="465" y="280" kind="note" width="190" height="62" />
      <bpmiq:sticky id="fmap_sticky_f1SignatureReminder" text="#1 Signature reminder (Stage 1)" x="925" y="270" kind="note" width="145" height="56" />
      <bpmiq:sticky id="fmap_sticky_d8ContractSignature" text="#8 Contract &#38; e-signature: make, buy or adapt?" x="691" y="554" kind="decision" width="138" height="52" />
      <bpmiq:sticky id="fmap_sticky_f18SignatureDeadline" text="#18 Signature deadline (Stage 1)" x="885" y="680" kind="note" width="145" height="56" />
      <bpmiq:sticky id="fmap_sticky_q18RevokeContract" text="Open in #18 and #8: does the rejection revoke the issued contract?" x="885" y="745" kind="question" width="175" height="62" />
      <bpmiq:sticky id="fmap_sticky_d9NotificationChannel" text="#9 Customer notification channel?" x="465" y="742" kind="decision" width="150" height="56" />
      <bpmiq:sticky id="fmap_sticky_d10DealerIntegration" text="#10 Dealer integration?" x="1545" y="362" kind="decision" width="125" height="50" />
      <bpmiq:sticky id="fmap_sticky_f21WithdrawalPeriod" text="#21 Withdrawal period (Stage 3)" x="1700" y="362" kind="note" width="150" height="50" />
      <bpmiq:sticky id="fmap_sticky_f7LiveAvailability" text="#7 Live dealer availability (Stage 4)" x="1180" y="700" kind="note" width="135" height="56" />
      <bpmiq:sticky id="fmap_sticky_f20AlternativeBike" text="#20 Alternative bike (Stage 2)" x="1560" y="650" kind="note" width="140" height="56" />
      <bpmiq:sticky id="fmap_sticky_f3AutomaticReversal" text="#3 Automatic reversal (Stage 3)" x="640" y="870" kind="note" width="160" height="50" />
      <bpmiq:sticky id="fmap_sticky_f4OrderCancellation" text="#4 Bike order cancellation (Stage 3)" x="1640" y="1190" kind="note" width="165" height="56" />
      <bpmiq:sticky id="fmap_sticky_q4WhichBranch" text="Open in #4: which answer leads to the return and the costs?" x="990" y="1160" kind="question" width="180" height="60" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="startEvent_leasingRequestReceived" name="Leasing request received">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
      <bpmn:outgoing>flow_requestToValidation</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="serviceTask_validateApplication" name="Validate application">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
      <bpmn:incoming>flow_requestToValidation</bpmn:incoming>
      <bpmn:outgoing>tbpm_flow_validationToValidGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="tbpm_gateway_applicationValid" name="Application valid?">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
      <bpmn:incoming>tbpm_flow_validationToValidGateway</bpmn:incoming>
      <bpmn:outgoing>tbpm_flow_applicationValid</bpmn:outgoing>
      <bpmn:outgoing>tbpm_flow_applicationInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="userTask_checkCreditRating" name="Check credit rating">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
      <bpmn:incoming>tbpm_flow_applicationValid</bpmn:incoming>
      <bpmn:outgoing>flow_creditCheckToSolvency</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_isSolvent" name="Solvent?">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
      <bpmn:incoming>flow_creditCheckToSolvency</bpmn:incoming>
      <bpmn:outgoing>flow_solvent</bpmn:outgoing>
      <bpmn:outgoing>flow_notSolvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_sendContract" name="Send contract">
      <bpmn:categoryValueRef>fmap_cv_coreContract</bpmn:categoryValueRef>
      <bpmn:incoming>flow_solvent</bpmn:incoming>
      <bpmn:outgoing>flow_contractSentToAwait</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="event_signatureReminder" name="7 days" cancelActivity="false" attachedToRef="serviceTask_sendContract">
      <bpmn:categoryValueRef>fmap_cv_coreContract</bpmn:categoryValueRef>
      <bpmn:outgoing>flow_reminderToMail</bpmn:outgoing>
      <bpmn:timerEventDefinition id="event_signatureReminder_timer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="serviceTask_sendReminderMail" name="Send reminder">
      <bpmn:categoryValueRef>fmap_cv_f1Reminder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_reminderToMail</bpmn:incoming>
      <bpmn:outgoing>flow_mailToProspectReminded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_prospectReminded" name="Customer reminded">
      <bpmn:categoryValueRef>fmap_cv_f1Reminder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_mailToProspectReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="gateway_awaitSignature">
      <bpmn:categoryValueRef>fmap_cv_f18SignatureDeadline</bpmn:categoryValueRef>
      <bpmn:categoryValueRef>fmap_cv_coreContract</bpmn:categoryValueRef>
      <bpmn:incoming>flow_contractSentToAwait</bpmn:incoming>
      <bpmn:outgoing>fmap_flow_awaitToSigned</bpmn:outgoing>
      <bpmn:outgoing>fmap_flow_awaitToDeadline</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="event_signatureDeadline" name="14 days">
      <bpmn:categoryValueRef>fmap_cv_f18SignatureDeadline</bpmn:categoryValueRef>
      <bpmn:incoming>fmap_flow_awaitToDeadline</bpmn:incoming>
      <bpmn:outgoing>flow_deadlineToRejection</bpmn:outgoing>
      <bpmn:timerEventDefinition id="event_signatureDeadline_timer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="event_contractSigned" name="Contract signed">
      <bpmn:categoryValueRef>fmap_cv_coreContract</bpmn:categoryValueRef>
      <bpmn:incoming>fmap_flow_awaitToSigned</bpmn:incoming>
      <bpmn:outgoing>flow_signedToFork</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="gateway_fork">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_signedToFork</bpmn:incoming>
      <bpmn:outgoing>flow_forkToInsurance</bpmn:outgoing>
      <bpmn:outgoing>flow_forkToOrder</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="serviceTask_issueInsurancePolicy" name="Issue insurance policy">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_forkToInsurance</bpmn:incoming>
      <bpmn:outgoing>flow_insuranceToJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_bikeSourceJoin">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_forkToOrder</bpmn:incoming>
      <bpmn:incoming>flow_alternativeFound</bpmn:incoming>
      <bpmn:outgoing>flow_bikeSourceToOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_orderBike" name="Order bike from dealer">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_bikeSourceToOrder</bpmn:incoming>
      <bpmn:outgoing>fmap_flow_orderToAvailability</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_bikeAvailable" name="Bike available?">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
      <bpmn:incoming>fmap_flow_orderToAvailability</bpmn:incoming>
      <bpmn:outgoing>flow_orderToJoin</bpmn:outgoing>
      <bpmn:outgoing>fmap_flow_availabilityToClarify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="userTask_clarifyAlternative" name="Clarify alternative with customer">
      <bpmn:categoryValueRef>fmap_cv_f20AlternativeBike</bpmn:categoryValueRef>
      <bpmn:incoming>fmap_flow_availabilityToClarify</bpmn:incoming>
      <bpmn:outgoing>flow_clarifyToAlternativeGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_alternativeFound" name="Alternative found?">
      <bpmn:categoryValueRef>fmap_cv_f20AlternativeBike</bpmn:categoryValueRef>
      <bpmn:incoming>flow_clarifyToAlternativeGateway</bpmn:incoming>
      <bpmn:outgoing>flow_alternativeFound</bpmn:outgoing>
      <bpmn:outgoing>flow_noAlternativeFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="event_triggerReversal" name="Reverse completed steps">
      <bpmn:categoryValueRef>fmap_cv_f20AlternativeBike</bpmn:categoryValueRef>
      <bpmn:incoming>flow_noAlternativeFound</bpmn:incoming>
      <bpmn:outgoing>fmap_flow_reversalToConfirmation</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="event_triggerReversal_compensate" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="serviceTask_confirmContractCancellation" name="Send cancellation confirmation">
      <bpmn:categoryValueRef>fmap_cv_f20AlternativeBike</bpmn:categoryValueRef>
      <bpmn:incoming>fmap_flow_reversalToConfirmation</bpmn:incoming>
      <bpmn:outgoing>flow_confirmationToContractCancelled</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_contractCancelled" name="Contract cancelled">
      <bpmn:categoryValueRef>fmap_cv_f20AlternativeBike</bpmn:categoryValueRef>
      <bpmn:incoming>flow_confirmationToContractCancelled</bpmn:incoming>
      <bpmn:terminateEventDefinition id="endEvent_contractCancelled_terminate" />
    </bpmn:endEvent>
    <bpmn:parallelGateway id="gateway_join">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_orderToJoin</bpmn:incoming>
      <bpmn:incoming>flow_insuranceToJoin</bpmn:incoming>
      <bpmn:outgoing>flow_joinToHandover</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateThrowEvent id="event_handoverReported" name="Handover reported">
      <bpmn:categoryValueRef>fmap_cv_coreActivate</bpmn:categoryValueRef>
      <bpmn:incoming>flow_joinToHandover</bpmn:incoming>
      <bpmn:outgoing>flow_handoverToWithdrawalPeriod</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="event_withdrawalPeriodElapsed" name="Await end of withdrawal period">
      <bpmn:categoryValueRef>fmap_cv_f21WithdrawalPeriod</bpmn:categoryValueRef>
      <bpmn:categoryValueRef>fmap_cv_coreActivate</bpmn:categoryValueRef>
      <bpmn:incoming>flow_handoverToWithdrawalPeriod</bpmn:incoming>
      <bpmn:outgoing>flow_withdrawalElapsedToActive</bpmn:outgoing>
      <bpmn:timerEventDefinition id="event_withdrawalPeriodElapsed_timer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endEvent_leasingActive" name="Leasing active">
      <bpmn:categoryValueRef>fmap_cv_coreActivate</bpmn:categoryValueRef>
      <bpmn:incoming>flow_withdrawalElapsedToActive</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gateway_rejectionJoin" name="Rejection reason">
      <bpmn:categoryValueRef>fmap_cv_coreReject</bpmn:categoryValueRef>
      <bpmn:incoming>tbpm_flow_applicationInvalid</bpmn:incoming>
      <bpmn:incoming>flow_notSolvent</bpmn:incoming>
      <bpmn:incoming>flow_deadlineToRejection</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionJoined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_sendRejection" name="Send rejection">
      <bpmn:categoryValueRef>fmap_cv_coreReject</bpmn:categoryValueRef>
      <bpmn:incoming>flow_rejectionJoined</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionSent</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_applicationRejected" name="Application rejected">
      <bpmn:categoryValueRef>fmap_cv_coreReject</bpmn:categoryValueRef>
      <bpmn:incoming>flow_rejectionSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="subProcess_applicationWithdrawn" name="Application withdrawn" triggeredByEvent="true">
      <bpmn:categoryValueRef>fmap_cv_coreWithdraw</bpmn:categoryValueRef>
      <bpmn:startEvent id="startEvent_applicationWithdrawn" name="Application&#10;withdrawn">
        <bpmn:categoryValueRef>fmap_cv_coreWithdraw</bpmn:categoryValueRef>
        <bpmn:outgoing>flow_withdrawnToReversal</bpmn:outgoing>
        <bpmn:messageEventDefinition id="startEvent_applicationWithdrawn_message" />
      </bpmn:startEvent>
      <bpmn:task id="userTask_reverseApplication" name="Reverse application">
        <bpmn:categoryValueRef>fmap_cv_coreWithdraw</bpmn:categoryValueRef>
        <bpmn:incoming>flow_withdrawnToReversal</bpmn:incoming>
        <bpmn:outgoing>flow_reversalToCancelled</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="endEvent_applicationCancelled" name="Application&#10;cancelled">
        <bpmn:categoryValueRef>fmap_cv_coreWithdraw</bpmn:categoryValueRef>
        <bpmn:incoming>flow_reversalToCancelled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_withdrawnToReversal" sourceRef="startEvent_applicationWithdrawn" targetRef="userTask_reverseApplication">
        <bpmn:categoryValueRef>fmap_cv_coreWithdraw</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="flow_reversalToCancelled" sourceRef="userTask_reverseApplication" targetRef="endEvent_applicationCancelled">
        <bpmn:categoryValueRef>fmap_cv_coreWithdraw</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="fmap_subProcess_automaticReversal" name="Application withdrawn (automatic reversal)" triggeredByEvent="true">
      <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
      <bpmn:startEvent id="fmap_startEvent_applicationWithdrawn" name="Application&#10;withdrawn">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
        <bpmn:outgoing>flow_withdrawalToReversal</bpmn:outgoing>
        <bpmn:messageEventDefinition id="fmap_startEvent_applicationWithdrawn_message" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="event_reverseApplication" name="Reverse completed steps">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
        <bpmn:incoming>flow_withdrawalToReversal</bpmn:incoming>
        <bpmn:outgoing>fmap_flow_reversalToBikeOrdered</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="event_reverseApplication_compensate" />
      </bpmn:intermediateThrowEvent>
      <bpmn:exclusiveGateway id="fmap_gateway_bikeOrdered" name="Bike already ordered?">
        <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
        <bpmn:incoming>fmap_flow_reversalToBikeOrdered</bpmn:incoming>
        <bpmn:outgoing>fmap_flow_bikeOrderedToCancelOrder</bpmn:outgoing>
        <bpmn:outgoing>fmap_flow_bikeNotOrdered</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:subProcess id="callActivity_cancelBikeOrder" name="Cancel bike order">
        <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
        <bpmn:incoming>fmap_flow_bikeOrderedToCancelOrder</bpmn:incoming>
        <bpmn:outgoing>fmap_flow_cancelOrderToJoin</bpmn:outgoing>
        <bpmn:startEvent id="startEvent_cancellationRequired" name="Cancellation required">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:outgoing>flow_requiredToRequest</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="serviceTask_requestCancellation" name="Request order cancellation">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:incoming>flow_requiredToRequest</bpmn:incoming>
          <bpmn:outgoing>flow_requestToPossibleGateway</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="gateway_cancellationPossible" name="Cancellation possible?">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:incoming>flow_requestToPossibleGateway</bpmn:incoming>
          <bpmn:outgoing>flow_cancellationPossible</bpmn:outgoing>
          <bpmn:outgoing>flow_cancellationNotPossible</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="userTask_clarifyReturn" name="Clarify return with dealer">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:incoming>flow_cancellationNotPossible</bpmn:incoming>
          <bpmn:outgoing>flow_clarifyToBookCosts</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="serviceTask_bookCosts" name="Book cancellation costs">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:incoming>flow_clarifyToBookCosts</bpmn:incoming>
          <bpmn:outgoing>flow_bookCostsToJoin</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="cbo_gateway_join">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:incoming>flow_cancellationPossible</bpmn:incoming>
          <bpmn:incoming>flow_bookCostsToJoin</bpmn:incoming>
          <bpmn:outgoing>flow_joinToReversed</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="endEvent_orderReversed" name="Order reversed">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:incoming>flow_joinToReversed</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="flow_requiredToRequest" sourceRef="startEvent_cancellationRequired" targetRef="serviceTask_requestCancellation">
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flow_requestToPossibleGateway" sourceRef="serviceTask_requestCancellation" targetRef="gateway_cancellationPossible">
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flow_cancellationPossible" sourceRef="gateway_cancellationPossible" targetRef="cbo_gateway_join">
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flow_cancellationNotPossible" sourceRef="gateway_cancellationPossible" targetRef="userTask_clarifyReturn">
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flow_clarifyToBookCosts" sourceRef="userTask_clarifyReturn" targetRef="serviceTask_bookCosts">
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flow_bookCostsToJoin" sourceRef="serviceTask_bookCosts" targetRef="cbo_gateway_join">
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flow_joinToReversed" sourceRef="cbo_gateway_join" targetRef="endEvent_orderReversed">
          <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="fmap_gateway_orderCancellationJoin">
        <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
        <bpmn:incoming>fmap_flow_bikeNotOrdered</bpmn:incoming>
        <bpmn:incoming>fmap_flow_cancelOrderToJoin</bpmn:incoming>
        <bpmn:outgoing>fmap_flow_joinToConfirmation</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="serviceTask_sendCancellationConfirmation" name="Send cancellation confirmation">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
        <bpmn:incoming>fmap_flow_joinToConfirmation</bpmn:incoming>
        <bpmn:outgoing>flow_confirmationToCancelled</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="fmap_endEvent_applicationCancelled" name="Application&#10;cancelled">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
        <bpmn:incoming>flow_confirmationToCancelled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_withdrawalToReversal" sourceRef="fmap_startEvent_applicationWithdrawn" targetRef="event_reverseApplication">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="fmap_flow_reversalToBikeOrdered" sourceRef="event_reverseApplication" targetRef="fmap_gateway_bikeOrdered">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="fmap_flow_bikeOrderedToCancelOrder" name="yes" sourceRef="fmap_gateway_bikeOrdered" targetRef="callActivity_cancelBikeOrder">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
        <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="fmap_flow_bikeNotOrdered" name="no" sourceRef="fmap_gateway_bikeOrdered" targetRef="fmap_gateway_orderCancellationJoin">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
        <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="fmap_flow_cancelOrderToJoin" sourceRef="callActivity_cancelBikeOrder" targetRef="fmap_gateway_orderCancellationJoin">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
        <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="fmap_flow_joinToConfirmation" sourceRef="fmap_gateway_orderCancellationJoin" targetRef="serviceTask_sendCancellationConfirmation">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="flow_confirmationToCancelled" sourceRef="serviceTask_sendCancellationConfirmation" targetRef="fmap_endEvent_applicationCancelled">
        <bpmn:categoryValueRef>fmap_cv_f3AutomaticReversal</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_requestToValidation" sourceRef="startEvent_leasingRequestReceived" targetRef="serviceTask_validateApplication">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="tbpm_flow_validationToValidGateway" sourceRef="serviceTask_validateApplication" targetRef="tbpm_gateway_applicationValid">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="tbpm_flow_applicationValid" name="yes" sourceRef="tbpm_gateway_applicationValid" targetRef="userTask_checkCreditRating">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="tbpm_flow_applicationInvalid" name="no" sourceRef="tbpm_gateway_applicationValid" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_creditCheckToSolvency" sourceRef="userTask_checkCreditRating" targetRef="gateway_isSolvent">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_solvent" name="yes" sourceRef="gateway_isSolvent" targetRef="serviceTask_sendContract" />
    <bpmn:sequenceFlow id="flow_notSolvent" name="no" sourceRef="gateway_isSolvent" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_contractSentToAwait" sourceRef="serviceTask_sendContract" targetRef="gateway_awaitSignature">
      <bpmn:categoryValueRef>fmap_cv_coreContract</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fmap_flow_awaitToSigned" sourceRef="gateway_awaitSignature" targetRef="event_contractSigned">
      <bpmn:categoryValueRef>fmap_cv_coreContract</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fmap_flow_awaitToDeadline" sourceRef="gateway_awaitSignature" targetRef="event_signatureDeadline">
      <bpmn:categoryValueRef>fmap_cv_f18SignatureDeadline</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_deadlineToRejection" sourceRef="event_signatureDeadline" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_reminderToMail" sourceRef="event_signatureReminder" targetRef="serviceTask_sendReminderMail" />
    <bpmn:sequenceFlow id="flow_mailToProspectReminded" sourceRef="serviceTask_sendReminderMail" targetRef="endEvent_prospectReminded">
      <bpmn:categoryValueRef>fmap_cv_f1Reminder</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_signedToFork" sourceRef="event_contractSigned" targetRef="gateway_fork" />
    <bpmn:sequenceFlow id="flow_forkToInsurance" sourceRef="gateway_fork" targetRef="serviceTask_issueInsurancePolicy">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_forkToOrder" sourceRef="gateway_fork" targetRef="gateway_bikeSourceJoin">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_bikeSourceToOrder" sourceRef="gateway_bikeSourceJoin" targetRef="serviceTask_orderBike">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fmap_flow_orderToAvailability" sourceRef="serviceTask_orderBike" targetRef="gateway_bikeAvailable">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_orderToJoin" name="yes" sourceRef="gateway_bikeAvailable" targetRef="gateway_join">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fmap_flow_availabilityToClarify" name="no" sourceRef="gateway_bikeAvailable" targetRef="userTask_clarifyAlternative" />
    <bpmn:sequenceFlow id="flow_clarifyToAlternativeGateway" sourceRef="userTask_clarifyAlternative" targetRef="gateway_alternativeFound">
      <bpmn:categoryValueRef>fmap_cv_f20AlternativeBike</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_alternativeFound" name="yes" sourceRef="gateway_alternativeFound" targetRef="gateway_bikeSourceJoin" />
    <bpmn:sequenceFlow id="flow_noAlternativeFound" name="no" sourceRef="gateway_alternativeFound" targetRef="event_triggerReversal">
      <bpmn:categoryValueRef>fmap_cv_f20AlternativeBike</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fmap_flow_reversalToConfirmation" sourceRef="event_triggerReversal" targetRef="serviceTask_confirmContractCancellation">
      <bpmn:categoryValueRef>fmap_cv_f20AlternativeBike</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_confirmationToContractCancelled" sourceRef="serviceTask_confirmContractCancellation" targetRef="endEvent_contractCancelled">
      <bpmn:categoryValueRef>fmap_cv_f20AlternativeBike</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_insuranceToJoin" sourceRef="serviceTask_issueInsurancePolicy" targetRef="gateway_join">
      <bpmn:categoryValueRef>fmap_cv_coreInsureOrder</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_joinToHandover" sourceRef="gateway_join" targetRef="event_handoverReported" />
    <bpmn:sequenceFlow id="flow_handoverToWithdrawalPeriod" sourceRef="event_handoverReported" targetRef="event_withdrawalPeriodElapsed">
      <bpmn:categoryValueRef>fmap_cv_coreActivate</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_withdrawalElapsedToActive" sourceRef="event_withdrawalPeriodElapsed" targetRef="endEvent_leasingActive">
      <bpmn:categoryValueRef>fmap_cv_coreActivate</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_rejectionJoined" sourceRef="gateway_rejectionJoin" targetRef="serviceTask_sendRejection">
      <bpmn:categoryValueRef>fmap_cv_coreReject</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_rejectionSent" sourceRef="serviceTask_sendRejection" targetRef="endEvent_applicationRejected">
      <bpmn:categoryValueRef>fmap_cv_coreReject</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:category id="fmap_category_features">
    <bpmn:categoryValue id="fmap_cv_coreApply" value="Core · runs today: apply, validate and check credit" />
    <bpmn:categoryValue id="fmap_cv_coreContract" value="Core · runs today: conclude the contract" />
    <bpmn:categoryValue id="fmap_cv_coreReject" value="Core · runs today: reject the application" />
    <bpmn:categoryValue id="fmap_cv_coreInsureOrder" value="Core · runs today: insure and order in parallel" />
    <bpmn:categoryValue id="fmap_cv_coreActivate" value="Core · runs today: hand over and activate" />
    <bpmn:categoryValue id="fmap_cv_coreWithdraw" value="Core · runs today: withdraw, reverse by hand" />
    <bpmn:categoryValue id="fmap_cv_f1Reminder" value="#1 Signature reminder" />
    <bpmn:categoryValue id="fmap_cv_f18SignatureDeadline" value="#18 Signature deadline" />
    <bpmn:categoryValue id="fmap_cv_f20AlternativeBike" value="#20 Alternative bike" />
    <bpmn:categoryValue id="fmap_cv_f21WithdrawalPeriod" value="#21 Withdrawal period" />
