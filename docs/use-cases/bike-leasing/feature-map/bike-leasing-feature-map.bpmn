<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmiq="https://bpmiq.io/schema/1.0/bpmiq" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="fmap_definitions_bikeLeasing" targetNamespace="http://miragon.io/miravelo/bike-leasing/feature-map" bpmiq:mode="workshop">
  <bpmn:collaboration id="fmap_collaboration_bikeLeasing">
    <bpmn:participant id="fmap_participant_bikeLeasing" name="Bike leasing — feature map" processRef="fmap_process_bikeLeasing" />
    <bpmn:group id="fmap_group_coreApply" categoryValueRef="fmap_cv_coreApply" />
    <bpmn:group id="fmap_group_coreContract" categoryValueRef="fmap_cv_coreContract" />
    <bpmn:group id="fmap_group_coreReject" categoryValueRef="fmap_cv_coreReject" />
    <bpmn:group id="fmap_group_coreOrder" categoryValueRef="fmap_cv_coreOrder" />
    <bpmn:group id="fmap_group_coreCancel" categoryValueRef="fmap_cv_coreCancel" />
    <bpmn:group id="fmap_group_coreActivate" categoryValueRef="fmap_cv_coreActivate" />
    <bpmn:group id="fmap_group_f1Reminder" categoryValueRef="fmap_cv_f1Reminder" />
    <bpmn:group id="fmap_group_f2Insurance" categoryValueRef="fmap_cv_f2Insurance" />
    <bpmn:group id="fmap_group_f3Withdrawal" categoryValueRef="fmap_cv_f3Withdrawal" />
    <bpmn:group id="fmap_group_f4OrderCancellation" categoryValueRef="fmap_cv_f4OrderCancellation" />
  </bpmn:collaboration>
  <bpmn:process id="fmap_process_bikeLeasing" name="Bike leasing — feature map" isExecutable="false">
    <bpmn:extensionElements>
      <bpmiq:sticky id="fmap_sticky_f6ApplicationList" text="#6 Application list (Stage 4)" x="40" y="4" kind="note" width="150" height="56" />
      <bpmiq:sticky id="fmap_sticky_f1SignatureReminder" text="#1 Signature reminder (Stage 1)" x="630" y="82" kind="note" width="140" height="56" />
      <bpmiq:sticky id="fmap_sticky_f1Shorthand" text="Shorthand: 7 days after sending. #1 lists two ways to model it." x="590" y="310" kind="note" width="180" height="62" />
      <bpmiq:sticky id="fmap_sticky_f2InsurancePolicy" text="#2 Insurance policy (Stage 2)" x="1265" y="82" kind="note" width="140" height="56" />
      <bpmiq:sticky id="fmap_sticky_f7BikeCatalogue" text="#7 Bike catalogue (Stage 4)" x="1030" y="322" kind="note" width="125" height="56" />
      <bpmiq:sticky id="fmap_sticky_d10DealerIntegration" text="#10 Dealer integration?" x="1165" y="322" kind="decision" width="125" height="56" />
      <bpmiq:sticky id="fmap_sticky_d8ContractSignature" text="#8 Contract &amp; e-signature: make, buy or adapt?" x="485" y="545" kind="decision" width="165" height="56" />
      <bpmiq:sticky id="fmap_sticky_d9NotificationChannel" text="#9 Customer notification channel?" x="745" y="768" kind="decision" width="150" height="56" />
      <bpmiq:sticky id="fmap_sticky_f5BackOfficeInbox" text="#5 Back-office inbox (Stage 4)" x="1165" y="768" kind="note" width="135" height="56" />
      <bpmiq:sticky id="fmap_sticky_d11TaskUi" text="#11 Back-office task UI?" x="1310" y="768" kind="decision" width="135" height="56" />
      <bpmiq:sticky id="fmap_sticky_f3Withdrawal" text="#3 Withdrawal (Stage 3)" x="1500" y="890" kind="note" width="140" height="56" />
      <bpmiq:sticky id="fmap_sticky_f4OrderCancellation" text="#4 Bike order cancellation (Stage 3)" x="1115" y="848" kind="note" width="150" height="56" />
      <bpmiq:sticky id="fmap_sticky_q4WhichBranch" text="Open in #4: which answer leads to the return and the costs?" x="625" y="1093" kind="question" width="180" height="60" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="startEvent_leasingRequestReceived" name="Leasing request received">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
      <bpmn:outgoing>flow_requestToCreditCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="businessRuleTask_checkCreditRating" name="Check credit rating">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
      <bpmn:incoming>flow_requestToCreditCheck</bpmn:incoming>
      <bpmn:outgoing>flow_creditCheckToSolvency</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_isSolvent" name="Solvent?">
      <bpmn:categoryValueRef>fmap_cv_coreApply</bpmn:categoryValueRef>
      <bpmn:incoming>flow_creditCheckToSolvency</bpmn:incoming>
      <bpmn:outgoing>flow_solvent</bpmn:outgoing>
      <bpmn:outgoing>flow_notSolvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_sendContract" name="Send contract">
      <bpmn:categoryValueRef>fmap_cv_coreContract</bpmn:categoryValueRef>
      <bpmn:incoming>flow_solvent</bpmn:incoming>
      <bpmn:outgoing>flow_contractSentToAwait</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_awaitSignature" name="Signed within 14 days?">
      <bpmn:categoryValueRef>fmap_cv_coreContract</bpmn:categoryValueRef>
      <bpmn:incoming>flow_contractSentToAwait</bpmn:incoming>
      <bpmn:outgoing>flow_contractConcludedToFork</bpmn:outgoing>
      <bpmn:outgoing>tbpm_flow_awaitToRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_rejectionJoin" name="Rejection reason">
      <bpmn:categoryValueRef>fmap_cv_coreReject</bpmn:categoryValueRef>
      <bpmn:incoming>flow_notSolvent</bpmn:incoming>
      <bpmn:incoming>tbpm_flow_awaitToRejection</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionJoined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_sendRejection" name="Send rejection">
      <bpmn:categoryValueRef>fmap_cv_coreReject</bpmn:categoryValueRef>
      <bpmn:incoming>flow_rejectionJoined</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionSent</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_applicationRejected" name="Application rejected">
      <bpmn:categoryValueRef>fmap_cv_coreReject</bpmn:categoryValueRef>
      <bpmn:incoming>flow_rejectionSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gateway_bikeSourceJoin">
      <bpmn:categoryValueRef>fmap_cv_coreOrder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_forkToBikeSource</bpmn:incoming>
      <bpmn:incoming>flow_alternativeFound</bpmn:incoming>
      <bpmn:outgoing>flow_bikeSourceToOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_orderBike" name="Order bike from dealer">
      <bpmn:categoryValueRef>fmap_cv_coreOrder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_bikeSourceToOrder</bpmn:incoming>
      <bpmn:outgoing>tbpm_flow_orderToAvailability</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="tbpm_gateway_bikeAvailable" name="Bike available?">
      <bpmn:categoryValueRef>fmap_cv_coreOrder</bpmn:categoryValueRef>
      <bpmn:incoming>tbpm_flow_orderToAvailability</bpmn:incoming>
      <bpmn:outgoing>flow_orderedToJoin</bpmn:outgoing>
      <bpmn:outgoing>tbpm_flow_availabilityToClarify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="userTask_clarifyAlternative" name="Clarify alternative with customer">
      <bpmn:categoryValueRef>fmap_cv_coreOrder</bpmn:categoryValueRef>
      <bpmn:incoming>tbpm_flow_availabilityToClarify</bpmn:incoming>
      <bpmn:outgoing>flow_clarifyToAlternativeGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_alternativeFound" name="Alternative found?">
      <bpmn:categoryValueRef>fmap_cv_coreOrder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_clarifyToAlternativeGateway</bpmn:incoming>
      <bpmn:outgoing>flow_alternativeFound</bpmn:outgoing>
      <bpmn:outgoing>tbpm_flow_alternativeGatewayToCancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_cancelContract" name="Cancel contract">
      <bpmn:categoryValueRef>fmap_cv_coreCancel</bpmn:categoryValueRef>
      <bpmn:incoming>tbpm_flow_alternativeGatewayToCancel</bpmn:incoming>
      <bpmn:outgoing>tbpm_flow_cancelToConfirmation</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="serviceTask_confirmContractCancellation" name="Send cancellation confirmation">
      <bpmn:categoryValueRef>fmap_cv_coreCancel</bpmn:categoryValueRef>
      <bpmn:incoming>tbpm_flow_cancelToConfirmation</bpmn:incoming>
      <bpmn:outgoing>flow_confirmationToContractCancelled</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_contractCancelled" name="Contract cancelled">
      <bpmn:categoryValueRef>fmap_cv_coreCancel</bpmn:categoryValueRef>
      <bpmn:incoming>flow_confirmationToContractCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="event_handoverReported" name="Handover reported">
      <bpmn:categoryValueRef>fmap_cv_coreActivate</bpmn:categoryValueRef>
      <bpmn:incoming>flow_joinToHandover</bpmn:incoming>
      <bpmn:outgoing>flow_handoverToWithdrawalPeriod</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="event_withdrawalPeriodElapsed" name="Await end of withdrawal period">
      <bpmn:categoryValueRef>fmap_cv_coreActivate</bpmn:categoryValueRef>
      <bpmn:incoming>flow_handoverToWithdrawalPeriod</bpmn:incoming>
      <bpmn:outgoing>flow_withdrawalElapsedToActive</bpmn:outgoing>
      <bpmn:timerEventDefinition id="tbpm_timer_withdrawalPeriod">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endEvent_leasingActive" name="Leasing active">
      <bpmn:categoryValueRef>fmap_cv_coreActivate</bpmn:categoryValueRef>
      <bpmn:incoming>flow_withdrawalElapsedToActive</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="event_signatureReminder" name="7 days" cancelActivity="false" attachedToRef="serviceTask_sendContract">
      <bpmn:categoryValueRef>fmap_cv_f1Reminder</bpmn:categoryValueRef>
      <bpmn:outgoing>flow_reminderToMail</bpmn:outgoing>
      <bpmn:timerEventDefinition id="fmap_timer_signatureReminder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="serviceTask_sendReminderMail" name="Send reminder">
      <bpmn:categoryValueRef>fmap_cv_f1Reminder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_reminderToMail</bpmn:incoming>
      <bpmn:outgoing>flow_mailToProspectReminded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_prospectReminded" name="Customer reminded">
      <bpmn:categoryValueRef>fmap_cv_f1Reminder</bpmn:categoryValueRef>
      <bpmn:incoming>flow_mailToProspectReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="gateway_fork">
      <bpmn:categoryValueRef>fmap_cv_f2Insurance</bpmn:categoryValueRef>
      <bpmn:incoming>flow_contractConcludedToFork</bpmn:incoming>
      <bpmn:outgoing>flow_forkToBikeSource</bpmn:outgoing>
      <bpmn:outgoing>flow_forkToInsurance</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="serviceTask_issueInsurancePolicy" name="Issue insurance policy">
      <bpmn:categoryValueRef>fmap_cv_f2Insurance</bpmn:categoryValueRef>
      <bpmn:incoming>flow_forkToInsurance</bpmn:incoming>
      <bpmn:outgoing>flow_insuranceToJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="gateway_join">
      <bpmn:categoryValueRef>fmap_cv_f2Insurance</bpmn:categoryValueRef>
      <bpmn:incoming>flow_insuranceToJoin</bpmn:incoming>
      <bpmn:incoming>flow_orderedToJoin</bpmn:incoming>
      <bpmn:outgoing>flow_joinToHandover</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="subProcess_applicationWithdrawn" name="Customer withdraws" triggeredByEvent="true">
      <bpmn:categoryValueRef>fmap_cv_f3Withdrawal</bpmn:categoryValueRef>
      <bpmn:startEvent id="startEvent_applicationWithdrawn" name="Application&#10;withdrawn">
        <bpmn:categoryValueRef>fmap_cv_f3Withdrawal</bpmn:categoryValueRef>
        <bpmn:outgoing>flow_withdrawalToReversal</bpmn:outgoing>
        <bpmn:messageEventDefinition id="fmap_message_applicationWithdrawn" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="event_reverseApplication" name="Reverse completed steps">
        <bpmn:categoryValueRef>fmap_cv_f3Withdrawal</bpmn:categoryValueRef>
        <bpmn:incoming>flow_withdrawalToReversal</bpmn:incoming>
        <bpmn:outgoing>fmap_flow_reversalToBikeOrdered</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="fmap_compensate_reverseApplication" />
      </bpmn:intermediateThrowEvent>
      <bpmn:exclusiveGateway id="fmap_gateway_bikeOrdered" name="Bike already&#10;ordered?">
        <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        <bpmn:incoming>fmap_flow_reversalToBikeOrdered</bpmn:incoming>
        <bpmn:outgoing>fmap_flow_bikeOrderedToCancelOrder</bpmn:outgoing>
        <bpmn:outgoing>fmap_flow_bikeNotOrdered</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:subProcess id="callActivity_cancelBikeOrder" name="Cancel bike order">
        <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        <bpmn:incoming>fmap_flow_bikeOrderedToCancelOrder</bpmn:incoming>
        <bpmn:outgoing>fmap_flow_cancelOrderToJoin</bpmn:outgoing>
        <bpmn:startEvent id="startEvent_cancellationRequired" name="Cancellation required">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:outgoing>flow_requiredToRequest</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="serviceTask_requestCancellation" name="Request order cancellation">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:incoming>flow_requiredToRequest</bpmn:incoming>
          <bpmn:outgoing>flow_requestToPossibleGateway</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="gateway_cancellationPossible" name="Cancellation possible?">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:incoming>flow_requestToPossibleGateway</bpmn:incoming>
          <bpmn:outgoing>flow_cancellationPossible</bpmn:outgoing>
          <bpmn:outgoing>flow_cancellationNotPossible</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="userTask_clarifyReturn" name="Clarify return with dealer">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:incoming>flow_cancellationNotPossible</bpmn:incoming>
          <bpmn:outgoing>flow_clarifyToBookCosts</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="serviceTask_bookCosts" name="Book cancellation costs">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:incoming>flow_clarifyToBookCosts</bpmn:incoming>
          <bpmn:outgoing>flow_bookCostsToJoin</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="cbo_gateway_join">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:incoming>flow_cancellationPossible</bpmn:incoming>
          <bpmn:incoming>flow_bookCostsToJoin</bpmn:incoming>
          <bpmn:outgoing>flow_joinToReversed</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="endEvent_orderReversed" name="Order reversed">
          <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
          <bpmn:incoming>flow_joinToReversed</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="flow_requiredToRequest" sourceRef="startEvent_cancellationRequired" targetRef="serviceTask_requestCancellation" />
        <bpmn:sequenceFlow id="flow_requestToPossibleGateway" sourceRef="serviceTask_requestCancellation" targetRef="gateway_cancellationPossible" />
        <bpmn:sequenceFlow id="flow_cancellationPossible" sourceRef="gateway_cancellationPossible" targetRef="cbo_gateway_join" />
        <bpmn:sequenceFlow id="flow_cancellationNotPossible" sourceRef="gateway_cancellationPossible" targetRef="userTask_clarifyReturn" />
        <bpmn:sequenceFlow id="flow_clarifyToBookCosts" sourceRef="userTask_clarifyReturn" targetRef="serviceTask_bookCosts" />
        <bpmn:sequenceFlow id="flow_bookCostsToJoin" sourceRef="serviceTask_bookCosts" targetRef="cbo_gateway_join" />
        <bpmn:sequenceFlow id="flow_joinToReversed" sourceRef="cbo_gateway_join" targetRef="endEvent_orderReversed" />
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="fmap_gateway_orderCancellationJoin">
        <bpmn:categoryValueRef>fmap_cv_f4OrderCancellation</bpmn:categoryValueRef>
        <bpmn:incoming>fmap_flow_bikeNotOrdered</bpmn:incoming>
        <bpmn:incoming>fmap_flow_cancelOrderToJoin</bpmn:incoming>
        <bpmn:outgoing>fmap_flow_joinToConfirmation</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="serviceTask_sendCancellationConfirmation" name="Send cancellation confirmation">
        <bpmn:categoryValueRef>fmap_cv_f3Withdrawal</bpmn:categoryValueRef>
        <bpmn:incoming>fmap_flow_joinToConfirmation</bpmn:incoming>
        <bpmn:outgoing>flow_confirmationToCancelled</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="endEvent_applicationCancelled" name="Leasing cancelled">
        <bpmn:categoryValueRef>fmap_cv_f3Withdrawal</bpmn:categoryValueRef>
        <bpmn:incoming>flow_confirmationToCancelled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_withdrawalToReversal" sourceRef="startEvent_applicationWithdrawn" targetRef="event_reverseApplication" />
      <bpmn:sequenceFlow id="fmap_flow_reversalToBikeOrdered" sourceRef="event_reverseApplication" targetRef="fmap_gateway_bikeOrdered" />
      <bpmn:sequenceFlow id="fmap_flow_bikeOrderedToCancelOrder" name="yes" sourceRef="fmap_gateway_bikeOrdered" targetRef="callActivity_cancelBikeOrder" />
      <bpmn:sequenceFlow id="fmap_flow_bikeNotOrdered" name="no" sourceRef="fmap_gateway_bikeOrdered" targetRef="fmap_gateway_orderCancellationJoin" />
      <bpmn:sequenceFlow id="fmap_flow_cancelOrderToJoin" sourceRef="callActivity_cancelBikeOrder" targetRef="fmap_gateway_orderCancellationJoin" />
      <bpmn:sequenceFlow id="fmap_flow_joinToConfirmation" sourceRef="fmap_gateway_orderCancellationJoin" targetRef="serviceTask_sendCancellationConfirmation" />
      <bpmn:sequenceFlow id="flow_confirmationToCancelled" sourceRef="serviceTask_sendCancellationConfirmation" targetRef="endEvent_applicationCancelled" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_requestToCreditCheck" sourceRef="startEvent_leasingRequestReceived" targetRef="businessRuleTask_checkCreditRating" />
    <bpmn:sequenceFlow id="flow_creditCheckToSolvency" sourceRef="businessRuleTask_checkCreditRating" targetRef="gateway_isSolvent" />
    <bpmn:sequenceFlow id="flow_solvent" name="yes" sourceRef="gateway_isSolvent" targetRef="serviceTask_sendContract" />
    <bpmn:sequenceFlow id="flow_notSolvent" name="no" sourceRef="gateway_isSolvent" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_contractSentToAwait" sourceRef="serviceTask_sendContract" targetRef="gateway_awaitSignature" />
    <bpmn:sequenceFlow id="flow_contractConcludedToFork" name="yes" sourceRef="gateway_awaitSignature" targetRef="gateway_fork" />
    <bpmn:sequenceFlow id="tbpm_flow_awaitToRejection" name="no" sourceRef="gateway_awaitSignature" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_rejectionJoined" sourceRef="gateway_rejectionJoin" targetRef="serviceTask_sendRejection" />
    <bpmn:sequenceFlow id="flow_rejectionSent" sourceRef="serviceTask_sendRejection" targetRef="endEvent_applicationRejected" />
    <bpmn:sequenceFlow id="flow_forkToBikeSource" sourceRef="gateway_fork" targetRef="gateway_bikeSourceJoin" />
    <bpmn:sequenceFlow id="flow_forkToInsurance" sourceRef="gateway_fork" targetRef="serviceTask_issueInsurancePolicy" />
    <bpmn:sequenceFlow id="flow_insuranceToJoin" sourceRef="serviceTask_issueInsurancePolicy" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="flow_bikeSourceToOrder" sourceRef="gateway_bikeSourceJoin" targetRef="serviceTask_orderBike" />
    <bpmn:sequenceFlow id="tbpm_flow_orderToAvailability" sourceRef="serviceTask_orderBike" targetRef="tbpm_gateway_bikeAvailable" />
    <bpmn:sequenceFlow id="flow_orderedToJoin" name="yes" sourceRef="tbpm_gateway_bikeAvailable" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="tbpm_flow_availabilityToClarify" name="no" sourceRef="tbpm_gateway_bikeAvailable" targetRef="userTask_clarifyAlternative" />
    <bpmn:sequenceFlow id="flow_joinToHandover" sourceRef="gateway_join" targetRef="event_handoverReported" />
    <bpmn:sequenceFlow id="flow_handoverToWithdrawalPeriod" sourceRef="event_handoverReported" targetRef="event_withdrawalPeriodElapsed" />
    <bpmn:sequenceFlow id="flow_withdrawalElapsedToActive" sourceRef="event_withdrawalPeriodElapsed" targetRef="endEvent_leasingActive" />
    <bpmn:sequenceFlow id="flow_clarifyToAlternativeGateway" sourceRef="userTask_clarifyAlternative" targetRef="gateway_alternativeFound" />
    <bpmn:sequenceFlow id="flow_alternativeFound" name="yes" sourceRef="gateway_alternativeFound" targetRef="gateway_bikeSourceJoin" />
    <bpmn:sequenceFlow id="tbpm_flow_alternativeGatewayToCancel" name="no" sourceRef="gateway_alternativeFound" targetRef="serviceTask_cancelContract" />
    <bpmn:sequenceFlow id="tbpm_flow_cancelToConfirmation" sourceRef="serviceTask_cancelContract" targetRef="serviceTask_confirmContractCancellation" />
