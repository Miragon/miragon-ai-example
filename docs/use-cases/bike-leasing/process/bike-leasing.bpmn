<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_bike_order" targetNamespace="http://miragon.io/miravelo/bike-order" exporter="Camunda Modeler" exporterVersion="5.20.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="Message_LeasingRequestReceived" name="miravelo.leasingRequestReceived" />
  <bpmn:message id="Message_ContractSigned" name="miravelo.contractSigned" />
  <bpmn:message id="Message_HandoverReported" name="miravelo.handoverReported" />
  <bpmn:message id="Message_LeasingActivated" name="miravelo.leasingActivated" />
  <bpmn:error id="Error_BikeUnavailable" name="Bike_Unavailable" errorCode="bikeUnavailable" />
  <bpmn:process id="bikeLeasingProcess" name="MiraVelo Bike Leasing" isExecutable="true" camunda:historyTimeToLive="P180D">
    <bpmn:startEvent id="startEvent_leasingRequestReceived" name="Leasing request received" camunda:asyncAfter="true">
      <bpmn:extensionElements>
        <!-- The message start event injects these variables. Message start events don't support
             camunda:inputOutput, so they are declared for bpmn-to-code via this extension property. -->
        <camunda:properties>
          <camunda:property name="additionalInputVariables" value="applicationId, bikeId, monthlyNetIncome, age" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_requestToCreditCheck</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0233gqq" messageRef="Message_LeasingRequestReceived" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_requestToCreditCheck" sourceRef="startEvent_leasingRequestReceived" targetRef="businessRuleTask_checkCreditRating" />
    <bpmn:businessRuleTask id="businessRuleTask_checkCreditRating" name="Check credit rating" camunda:resultVariable="solvent" camunda:decisionRef="checkCreditRating" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>flow_requestToCreditCheck</bpmn:incoming>
      <bpmn:outgoing>flow_creditCheckToSolvency</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="flow_creditCheckToSolvency" sourceRef="businessRuleTask_checkCreditRating" targetRef="gateway_isSolvent" />
    <bpmn:exclusiveGateway id="gateway_isSolvent" name="Solvent?" default="flow_solvent">
      <bpmn:incoming>flow_creditCheckToSolvency</bpmn:incoming>
      <bpmn:outgoing>flow_solvent</bpmn:outgoing>
      <bpmn:outgoing>flow_notSolvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_solvent" sourceRef="gateway_isSolvent" targetRef="serviceTask_sendContract" />
    <bpmn:sequenceFlow id="flow_notSolvent" name="No" sourceRef="gateway_isSolvent" targetRef="gateway_rejectionJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!solvent}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="serviceTask_sendContract" name="Send contract" camunda:asyncAfter="true" camunda:delegateExpression="#{sendContractDelegate}">
      <bpmn:incoming>flow_solvent</bpmn:incoming>
      <bpmn:outgoing>flow_contractSentToAwait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="event_compensateContract" name="Compensate contract" attachedToRef="serviceTask_sendContract">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_0v0vumq" />
    </bpmn:boundaryEvent>
    <!-- Compensation handler of "Send contract": it runs only when "Trigger reversal" is thrown after
         the customer declined every alternative bike. A rejection after the 14-day signature deadline
         does not revoke the contract that was sent. -->
    <bpmn:serviceTask id="serviceTask_cancelContract" name="Cancel contract" isForCompensation="true" camunda:asyncAfter="true" camunda:delegateExpression="#{cancelContractDelegate}" />
    <bpmn:sequenceFlow id="flow_contractSentToAwait" sourceRef="serviceTask_sendContract" targetRef="gateway_awaitSignature" />
    <bpmn:eventBasedGateway id="gateway_awaitSignature">
      <bpmn:incoming>flow_contractSentToAwait</bpmn:incoming>
      <bpmn:outgoing>flow_awaitToSigned</bpmn:outgoing>
      <bpmn:outgoing>flow_awaitToDeadline</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="flow_awaitToSigned" sourceRef="gateway_awaitSignature" targetRef="event_contractSigned" />
    <bpmn:sequenceFlow id="flow_awaitToDeadline" sourceRef="gateway_awaitSignature" targetRef="event_signatureDeadline" />
    <bpmn:intermediateCatchEvent id="event_contractSigned" name="Contract signed" camunda:asyncAfter="true">
      <bpmn:incoming>flow_awaitToSigned</bpmn:incoming>
      <bpmn:outgoing>flow_signedToBikeSource</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1s3mj11" messageRef="Message_ContractSigned" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="event_signatureDeadline" name="14 days">
      <bpmn:incoming>flow_awaitToDeadline</bpmn:incoming>
      <bpmn:outgoing>flow_deadlineToRejection</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0hpbdck">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="flow_deadlineToRejection" sourceRef="event_signatureDeadline" targetRef="gateway_rejectionJoin" />
    <bpmn:exclusiveGateway id="gateway_rejectionJoin" name="Rejection reason">
      <bpmn:incoming>flow_notSolvent</bpmn:incoming>
      <bpmn:incoming>flow_deadlineToRejection</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionJoined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_rejectionJoined" sourceRef="gateway_rejectionJoin" targetRef="serviceTask_sendRejection" />
    <bpmn:serviceTask id="serviceTask_sendRejection" name="Send rejection" camunda:asyncAfter="true" camunda:delegateExpression="#{sendRejectionDelegate}">
      <bpmn:incoming>flow_rejectionJoined</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionSent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_rejectionSent" sourceRef="serviceTask_sendRejection" targetRef="endEvent_applicationRejected" />
    <bpmn:endEvent id="endEvent_applicationRejected" name="Application rejected">
      <bpmn:incoming>flow_rejectionSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_signedToBikeSource" sourceRef="event_contractSigned" targetRef="gateway_bikeSourceJoin" />
    <bpmn:exclusiveGateway id="gateway_bikeSourceJoin">
      <bpmn:incoming>flow_signedToBikeSource</bpmn:incoming>
      <bpmn:incoming>flow_alternativeFound</bpmn:incoming>
      <bpmn:outgoing>flow_bikeSourceToOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_bikeSourceToOrder" sourceRef="gateway_bikeSourceJoin" targetRef="serviceTask_orderBike" />
    <bpmn:serviceTask id="serviceTask_orderBike" name="Order bike from dealer" camunda:asyncBefore="true" camunda:delegateExpression="#{orderBikeDelegate}">
      <bpmn:extensionElements>
        <!-- The bike the orderBikeDelegate orders and the result variable it writes; declared for
             bpmn-to-code without a self-referential I/O mapping. -->
        <camunda:properties>
          <camunda:property name="additionalInputVariables" value="bikeId" />
          <camunda:property name="additionalOutputVariables" value="orderId" />
        </camunda:properties>
        <!-- Incident demo: asyncBefore makes the order step its own job, so the delegate runs (and
             retries) as this activity's job rather than in the upstream continuation — that is what
             lets the retry cycle below apply and pins the failing job to serviceTask_orderBike.
             3 retries, 10s apart, so the countdown is visible in the Cockpit before an incident is
             raised (~30s). Reproduce it with the poison bike BIKE-FAIL and the 08-incident-demo
             Bruno collection. -->
        <camunda:failedJobRetryTimeCycle>R3/PT10S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_bikeSourceToOrder</bpmn:incoming>
      <bpmn:outgoing>flow_orderedToHandover</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="event_bikeUnavailable" name="Bike unavailable" attachedToRef="serviceTask_orderBike">
      <bpmn:outgoing>flow_bikeUnavailable</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_bikeUnavailable" errorRef="Error_BikeUnavailable" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_bikeUnavailable" sourceRef="event_bikeUnavailable" targetRef="userTask_clarifyAlternative" />
    <bpmn:userTask id="userTask_clarifyAlternative" name="Clarify alternative with customer" camunda:asyncAfter="true" camunda:formRef="clarifyAlternativeForm" camunda:formRefBinding="deployment">
      <bpmn:documentation>Completable two ways: a human via the deployed Camunda Form (Tasklist), or a client via POST /api/bike-leasing/{id}/clarify-alternative. Both paths hand the chosen alternative to the process as the bikeId variable, which the re-order reads and persists on the aggregate, so the captured data reaches the domain model either way. An accepted alternative always names its bike: the form requires the field and the endpoint answers 400 without it.</bpmn:documentation>
      <bpmn:extensionElements>
        <!-- The decision the task produces and the alternative bike the re-order picks up; declared
             for bpmn-to-code. The Camunda Form (camunda:formRef) still renders them in the Tasklist
             for the human completion path. -->
        <camunda:properties>
          <camunda:property name="additionalOutputVariables" value="alternativeFound, bikeId" />
        </camunda:properties>
        <camunda:taskListener event="create" delegateExpression="#{clarifyAlternativeTaskListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_bikeUnavailable</bpmn:incoming>
      <bpmn:outgoing>flow_clarifyToAlternativeGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_clarifyToAlternativeGateway" sourceRef="userTask_clarifyAlternative" targetRef="gateway_alternativeFound" />
    <bpmn:exclusiveGateway id="gateway_alternativeFound" name="Alternative found?" default="flow_alternativeFound">
      <bpmn:incoming>flow_clarifyToAlternativeGateway</bpmn:incoming>
      <bpmn:outgoing>flow_alternativeFound</bpmn:outgoing>
      <bpmn:outgoing>flow_noAlternativeFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_alternativeFound" name="Yes" sourceRef="gateway_alternativeFound" targetRef="gateway_bikeSourceJoin" />
    <bpmn:sequenceFlow id="flow_noAlternativeFound" name="No" sourceRef="gateway_alternativeFound" targetRef="event_triggerReversal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!alternativeFound}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateThrowEvent id="event_triggerReversal" name="Trigger reversal">
      <bpmn:incoming>flow_noAlternativeFound</bpmn:incoming>
      <bpmn:outgoing>flow_triggerReversalToConfirmation</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_1acwjf2" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="flow_triggerReversalToConfirmation" sourceRef="event_triggerReversal" targetRef="serviceTask_confirmContractCancellation" />
    <bpmn:serviceTask id="serviceTask_confirmContractCancellation" name="Send cancellation confirmation" camunda:asyncAfter="true" camunda:delegateExpression="#{sendCancellationConfirmationDelegate}">
      <bpmn:incoming>flow_triggerReversalToConfirmation</bpmn:incoming>
      <bpmn:outgoing>flow_confirmationToContractCancelled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_confirmationToContractCancelled" sourceRef="serviceTask_confirmContractCancellation" targetRef="endEvent_contractCancelled" />
    <bpmn:endEvent id="endEvent_contractCancelled" name="Contract cancelled">
      <bpmn:incoming>flow_confirmationToContractCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_orderedToHandover" sourceRef="serviceTask_orderBike" targetRef="event_handoverReported" />
    <bpmn:intermediateCatchEvent id="event_handoverReported" name="Handover reported" camunda:asyncAfter="true">
      <bpmn:incoming>flow_orderedToHandover</bpmn:incoming>
      <bpmn:outgoing>flow_handoverToWithdrawalPeriod</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1m0s1ya" messageRef="Message_HandoverReported" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="flow_handoverToWithdrawalPeriod" sourceRef="event_handoverReported" targetRef="event_withdrawalPeriodElapsed" />
    <bpmn:intermediateCatchEvent id="event_withdrawalPeriodElapsed" name="Await end of withdrawal period">
      <bpmn:incoming>flow_handoverToWithdrawalPeriod</bpmn:incoming>
      <bpmn:outgoing>flow_withdrawalElapsedToActive</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0j3mkdd">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="flow_withdrawalElapsedToActive" sourceRef="event_withdrawalPeriodElapsed" targetRef="endEvent_leasingActive" />
    <bpmn:endEvent id="endEvent_leasingActive" name="Leasing active">
      <bpmn:incoming>flow_withdrawalElapsedToActive</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_activateLeasingDelegate" messageRef="Message_LeasingActivated" camunda:delegateExpression="#{activateLeasingDelegate}" />
    </bpmn:endEvent>
    <bpmn:association id="Association_1q9i1wm" associationDirection="One" sourceRef="event_compensateContract" targetRef="serviceTask_cancelContract" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="bikeLeasingProcess">
