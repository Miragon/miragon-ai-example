<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmiq="https://bpmiq.io/schema/1.0/bpmiq" id="tbpm_definitions_bikeLeasing" targetNamespace="http://miragon.io/miravelo/bike-leasing/tbpm" bpmiq:mode="workshop">
  <bpmn:collaboration id="tbpm_collaboration_bikeLeasing">
    <bpmn:participant id="tbpm_participant_bikeLeasing" name="Bike leasing" processRef="tbpm_process_bikeLeasing" />
  </bpmn:collaboration>
  <bpmn:process id="tbpm_process_bikeLeasing" name="Bike leasing" isExecutable="false">
    <bpmn:extensionElements>
      <bpmiq:sticky id="tbpm_sticky_customer" text="Customer" x="160" y="80" kind="role" width="110" height="60" />
      <bpmiq:sticky id="tbpm_sticky_backOffice" text="Back office" x="480" y="340" kind="role" width="110" height="60" />
      <bpmiq:sticky id="tbpm_sticky_dealer" text="Dealer" x="1200" y="340" kind="role" width="110" height="60" />
      <bpmiq:sticky id="tbpm_sticky_core" text="This is the core. Everything else is on the feature map." x="1240" y="60" kind="note" width="180" height="80" />
    </bpmn:extensionElements>
    <bpmn:dataObject id="tbpm_dataObject_leasingContractData" />
    <bpmn:startEvent id="startEvent_leasingRequestReceived" name="Leasing request received">
      <bpmn:outgoing>flow_requestToValidation</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="serviceTask_validateApplication" name="Validate application">
      <bpmn:incoming>flow_requestToValidation</bpmn:incoming>
      <bpmn:outgoing>tbpm_flow_validationToValidGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="tbpm_gateway_applicationValid" name="Application valid?">
      <bpmn:incoming>tbpm_flow_validationToValidGateway</bpmn:incoming>
      <bpmn:outgoing>tbpm_flow_applicationValid</bpmn:outgoing>
      <bpmn:outgoing>tbpm_flow_applicationInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="userTask_checkCreditRating" name="Check credit rating">
      <bpmn:incoming>tbpm_flow_applicationValid</bpmn:incoming>
      <bpmn:outgoing>flow_creditCheckToSolvency</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_isSolvent" name="Solvent?">
      <bpmn:incoming>flow_creditCheckToSolvency</bpmn:incoming>
      <bpmn:outgoing>flow_solvent</bpmn:outgoing>
      <bpmn:outgoing>flow_notSolvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_sendContract" name="Send contract">
      <bpmn:incoming>flow_solvent</bpmn:incoming>
      <bpmn:outgoing>flow_contractSentToSigned</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="tbpm_dataOutput_sendContractToLeasingContract">
        <bpmn:targetRef>tbpm_dataObject_leasingContract</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="tbpm_dataObject_leasingContract" name="Leasing contract" dataObjectRef="tbpm_dataObject_leasingContractData">
    </bpmn:dataObjectReference>
    <bpmn:intermediateThrowEvent id="event_contractSigned" name="Contract signed">
      <bpmn:incoming>flow_contractSentToSigned</bpmn:incoming>
      <bpmn:outgoing>flow_signedToFork</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="gateway_fork">
      <bpmn:incoming>flow_signedToFork</bpmn:incoming>
      <bpmn:outgoing>flow_forkToInsurance</bpmn:outgoing>
      <bpmn:outgoing>flow_forkToOrder</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="serviceTask_issueInsurancePolicy" name="Issue insurance policy">
      <bpmn:incoming>flow_forkToInsurance</bpmn:incoming>
      <bpmn:outgoing>flow_insuranceToJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="serviceTask_orderBike" name="Order bike from dealer">
      <bpmn:incoming>flow_forkToOrder</bpmn:incoming>
      <bpmn:outgoing>flow_orderToJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="gateway_join">
      <bpmn:incoming>flow_insuranceToJoin</bpmn:incoming>
      <bpmn:incoming>flow_orderToJoin</bpmn:incoming>
      <bpmn:outgoing>flow_joinToHandover</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateThrowEvent id="event_handoverReported" name="Handover reported">
      <bpmn:incoming>flow_joinToHandover</bpmn:incoming>
      <bpmn:outgoing>flow_handoverToActive</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="endEvent_leasingActive" name="Leasing active">
      <bpmn:incoming>flow_handoverToActive</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gateway_rejectionJoin" name="Rejection reason">
      <bpmn:incoming>tbpm_flow_applicationInvalid</bpmn:incoming>
      <bpmn:incoming>flow_notSolvent</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionJoined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_sendRejection" name="Send rejection">
      <bpmn:incoming>flow_rejectionJoined</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionSent</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_applicationRejected" name="Application rejected">
      <bpmn:incoming>flow_rejectionSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="subProcess_applicationWithdrawn" name="Application withdrawn" triggeredByEvent="true">
      <bpmn:startEvent id="startEvent_applicationWithdrawn" name="Application&#10;withdrawn">
        <bpmn:outgoing>flow_withdrawnToReversal</bpmn:outgoing>
        <bpmn:messageEventDefinition id="startEvent_applicationWithdrawn_message" />
      </bpmn:startEvent>
      <bpmn:task id="userTask_reverseApplication" name="Reverse application">
        <bpmn:incoming>flow_withdrawnToReversal</bpmn:incoming>
        <bpmn:outgoing>flow_reversalToCancelled</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="endEvent_applicationCancelled" name="Application&#10;cancelled">
        <bpmn:incoming>flow_reversalToCancelled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_withdrawnToReversal" sourceRef="startEvent_applicationWithdrawn" targetRef="userTask_reverseApplication" />
      <bpmn:sequenceFlow id="flow_reversalToCancelled" sourceRef="userTask_reverseApplication" targetRef="endEvent_applicationCancelled" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_requestToValidation" sourceRef="startEvent_leasingRequestReceived" targetRef="serviceTask_validateApplication" />
    <bpmn:sequenceFlow id="tbpm_flow_validationToValidGateway" sourceRef="serviceTask_validateApplication" targetRef="tbpm_gateway_applicationValid" />
    <bpmn:sequenceFlow id="tbpm_flow_applicationValid" name="yes" sourceRef="tbpm_gateway_applicationValid" targetRef="userTask_checkCreditRating" />
    <bpmn:sequenceFlow id="tbpm_flow_applicationInvalid" name="no" sourceRef="tbpm_gateway_applicationValid" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_creditCheckToSolvency" sourceRef="userTask_checkCreditRating" targetRef="gateway_isSolvent" />
    <bpmn:sequenceFlow id="flow_solvent" name="yes" sourceRef="gateway_isSolvent" targetRef="serviceTask_sendContract" />
    <bpmn:sequenceFlow id="flow_notSolvent" name="no" sourceRef="gateway_isSolvent" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_contractSentToSigned" sourceRef="serviceTask_sendContract" targetRef="event_contractSigned" />
    <bpmn:sequenceFlow id="flow_signedToFork" sourceRef="event_contractSigned" targetRef="gateway_fork" />
    <bpmn:sequenceFlow id="flow_forkToInsurance" sourceRef="gateway_fork" targetRef="serviceTask_issueInsurancePolicy" />
    <bpmn:sequenceFlow id="flow_forkToOrder" sourceRef="gateway_fork" targetRef="serviceTask_orderBike" />
    <bpmn:sequenceFlow id="flow_insuranceToJoin" sourceRef="serviceTask_issueInsurancePolicy" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="flow_orderToJoin" sourceRef="serviceTask_orderBike" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="flow_joinToHandover" sourceRef="gateway_join" targetRef="event_handoverReported" />
    <bpmn:sequenceFlow id="flow_handoverToActive" sourceRef="event_handoverReported" targetRef="endEvent_leasingActive" />
    <bpmn:sequenceFlow id="flow_rejectionJoined" sourceRef="gateway_rejectionJoin" targetRef="serviceTask_sendRejection" />
    <bpmn:sequenceFlow id="flow_rejectionSent" sourceRef="serviceTask_sendRejection" targetRef="endEvent_applicationRejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="tbpm_diagram_bikeLeasing">
    <bpmndi:BPMNPlane id="tbpm_plane_bikeLeasing" bpmnElement="tbpm_collaboration_bikeLeasing">
      <bpmndi:BPMNShape id="tbpm_participant_bikeLeasing_di" bpmnElement="tbpm_participant_bikeLeasing" isHorizontal="true">
        <dc:Bounds x="120" y="30" width="1340" height="570" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="startEvent_leasingRequestReceived_di" bpmnElement="startEvent_leasingRequestReceived">
        <dc:Bounds x="182" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="284" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_validateApplication_di" bpmnElement="serviceTask_validateApplication">
        <dc:Bounds x="260" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tbpm_gateway_applicationValid_di" bpmnElement="tbpm_gateway_applicationValid" isMarkerVisible="true">
        <dc:Bounds x="395" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="375" y="291" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_checkCreditRating_di" bpmnElement="userTask_checkCreditRating">
        <dc:Bounds x="480" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_isSolvent_di" bpmnElement="gateway_isSolvent" isMarkerVisible="true">
        <dc:Bounds x="615" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="615.2" y="291" width="49.6" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_sendContract_di" bpmnElement="serviceTask_sendContract">
        <dc:Bounds x="700" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tbpm_dataObject_leasingContract_di" bpmnElement="tbpm_dataObject_leasingContract">
        <dc:Bounds x="732" y="330" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="705" y="386" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_contractSigned_di" bpmnElement="event_contractSigned">
        <dc:Bounds x="842" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="815" y="284" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_fork_di" bpmnElement="gateway_fork">
        <dc:Bounds x="925" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_issueInsurancePolicy_di" bpmnElement="serviceTask_issueInsurancePolicy">
        <dc:Bounds x="1010" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_orderBike_di" bpmnElement="serviceTask_orderBike">
        <dc:Bounds x="1010" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_join_di" bpmnElement="gateway_join">
        <dc:Bounds x="1145" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_handoverReported_di" bpmnElement="event_handoverReported">
        <dc:Bounds x="1252" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1225" y="284" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_leasingActive_di" bpmnElement="endEvent_leasingActive">
        <dc:Bounds x="1352" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1326.6" y="284" width="86.8" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_rejectionJoin_di" bpmnElement="gateway_rejectionJoin" isMarkerVisible="true">
        <dc:Bounds x="615" y="75" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="595" y="42" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_sendRejection_di" bpmnElement="serviceTask_sendRejection">
        <dc:Bounds x="700" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_applicationRejected_di" bpmnElement="endEvent_applicationRejected">
        <dc:Bounds x="842" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="815" y="124" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subProcess_applicationWithdrawn_di" bpmnElement="subProcess_applicationWithdrawn" isExpanded="true">
        <dc:Bounds x="260" y="440" width="380" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="startEvent_applicationWithdrawn_di" bpmnElement="startEvent_applicationWithdrawn">
        <dc:Bounds x="302" y="487" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="285.9" y="529" width="68.2" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_reverseApplication_di" bpmnElement="userTask_reverseApplication">
        <dc:Bounds x="390" y="465" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_applicationCancelled_di" bpmnElement="endEvent_applicationCancelled">
        <dc:Bounds x="552" y="487" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="535.9" y="529" width="68.2" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_requestToValidation_di" bpmnElement="flow_requestToValidation">
        <di:waypoint x="218" y="260" />
        <di:waypoint x="260" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_flow_validationToValidGateway_di" bpmnElement="tbpm_flow_validationToValidGateway">
        <di:waypoint x="360" y="260" />
        <di:waypoint x="395" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_flow_applicationValid_di" bpmnElement="tbpm_flow_applicationValid">
        <di:waypoint x="445" y="260" />
        <di:waypoint x="480" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="453" y="240" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_flow_applicationInvalid_di" bpmnElement="tbpm_flow_applicationInvalid">
        <di:waypoint x="420" y="235" />
        <di:waypoint x="420" y="100" />
        <di:waypoint x="615" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="426" y="205" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_creditCheckToSolvency_di" bpmnElement="flow_creditCheckToSolvency">
        <di:waypoint x="580" y="260" />
        <di:waypoint x="615" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_solvent_di" bpmnElement="flow_solvent">
        <di:waypoint x="665" y="260" />
        <di:waypoint x="700" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="673" y="240" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notSolvent_di" bpmnElement="flow_notSolvent">
        <di:waypoint x="640" y="235" />
        <di:waypoint x="640" y="125" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="646" y="170" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_contractSentToSigned_di" bpmnElement="flow_contractSentToSigned">
        <di:waypoint x="800" y="260" />
        <di:waypoint x="842" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_signedToFork_di" bpmnElement="flow_signedToFork">
        <di:waypoint x="878" y="260" />
        <di:waypoint x="925" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_forkToInsurance_di" bpmnElement="flow_forkToInsurance">
        <di:waypoint x="950" y="235" />
        <di:waypoint x="950" y="160" />
        <di:waypoint x="1010" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_forkToOrder_di" bpmnElement="flow_forkToOrder">
        <di:waypoint x="950" y="285" />
        <di:waypoint x="950" y="360" />
        <di:waypoint x="1010" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_insuranceToJoin_di" bpmnElement="flow_insuranceToJoin">
        <di:waypoint x="1110" y="160" />
        <di:waypoint x="1170" y="160" />
        <di:waypoint x="1170" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_orderToJoin_di" bpmnElement="flow_orderToJoin">
        <di:waypoint x="1110" y="360" />
        <di:waypoint x="1170" y="360" />
        <di:waypoint x="1170" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_joinToHandover_di" bpmnElement="flow_joinToHandover">
        <di:waypoint x="1195" y="260" />
        <di:waypoint x="1252" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_handoverToActive_di" bpmnElement="flow_handoverToActive">
        <di:waypoint x="1288" y="260" />
        <di:waypoint x="1352" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rejectionJoined_di" bpmnElement="flow_rejectionJoined">
        <di:waypoint x="665" y="100" />
        <di:waypoint x="700" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rejectionSent_di" bpmnElement="flow_rejectionSent">
        <di:waypoint x="800" y="100" />
        <di:waypoint x="842" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_withdrawnToReversal_di" bpmnElement="flow_withdrawnToReversal">
        <di:waypoint x="338" y="505" />
        <di:waypoint x="390" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reversalToCancelled_di" bpmnElement="flow_reversalToCancelled">
        <di:waypoint x="490" y="505" />
        <di:waypoint x="552" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_dataOutput_sendContractToLeasingContract_di" bpmnElement="tbpm_dataOutput_sendContractToLeasingContract">
        <di:waypoint x="750" y="300" />
        <di:waypoint x="750" y="330" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
