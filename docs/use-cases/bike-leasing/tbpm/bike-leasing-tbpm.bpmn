<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmiq="https://bpmiq.io/schema/1.0/bpmiq" id="tbpm_definitions_bikeLeasing" targetNamespace="http://miragon.io/miravelo/bike-leasing/tbpm" bpmiq:mode="workshop">
  <bpmn:collaboration id="tbpm_collaboration_bikeLeasing">
    <bpmn:participant id="tbpm_participant_bikeLeasing" name="Bike leasing" processRef="tbpm_process_bikeLeasing" />
  </bpmn:collaboration>
  <bpmn:process id="tbpm_process_bikeLeasing" name="Bike leasing" isExecutable="false">
    <bpmn:extensionElements>
      <bpmiq:sticky id="tbpm_sticky_customer" text="Customer" x="170" y="100" kind="role" width="110" height="60" />
      <bpmiq:sticky id="tbpm_sticky_dealer" text="Dealer" x="1070" y="92" kind="role" width="110" height="60" />
      <bpmiq:sticky id="tbpm_sticky_backOffice" text="Back office" x="870" y="350" kind="role" width="110" height="60" />
      <bpmiq:sticky id="tbpm_sticky_core" text="This is the core. Everything else is on the feature map." x="1420" y="60" kind="note" width="180" height="80" />
    </bpmn:extensionElements>
    <bpmn:dataObject id="tbpm_dataObject_leasingContractData" />
    <bpmn:startEvent id="startEvent_leasingRequestReceived" name="Leasing request received">
      <bpmn:outgoing>flow_requestToCreditCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="businessRuleTask_checkCreditRating" name="Check credit rating">
      <bpmn:incoming>flow_requestToCreditCheck</bpmn:incoming>
      <bpmn:outgoing>flow_creditCheckToSolvency</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_isSolvent" name="Solvent?">
      <bpmn:incoming>flow_creditCheckToSolvency</bpmn:incoming>
      <bpmn:outgoing>flow_solvent</bpmn:outgoing>
      <bpmn:outgoing>flow_notSolvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_sendContract" name="Send contract">
      <bpmn:incoming>flow_solvent</bpmn:incoming>
      <bpmn:outgoing>flow_contractSentToAwait</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="tbpm_dataOutput_sendContractToLeasingContract">
        <bpmn:targetRef>tbpm_dataObject_leasingContract</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="tbpm_dataObject_leasingContract" name="Leasing contract" dataObjectRef="tbpm_dataObject_leasingContractData" />
    <bpmn:exclusiveGateway id="gateway_awaitSignature" name="Signed within 14 days?">
      <bpmn:incoming>flow_contractSentToAwait</bpmn:incoming>
      <bpmn:outgoing>tbpm_flow_awaitToBikeSource</bpmn:outgoing>
      <bpmn:outgoing>tbpm_flow_awaitToRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_rejectionJoin" name="Rejection reason">
      <bpmn:incoming>flow_notSolvent</bpmn:incoming>
      <bpmn:incoming>tbpm_flow_awaitToRejection</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionJoined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_sendRejection" name="Send rejection">
      <bpmn:incoming>flow_rejectionJoined</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionSent</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_applicationRejected" name="Application rejected">
      <bpmn:incoming>flow_rejectionSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gateway_bikeSourceJoin">
      <bpmn:incoming>tbpm_flow_awaitToBikeSource</bpmn:incoming>
      <bpmn:incoming>flow_alternativeFound</bpmn:incoming>
      <bpmn:outgoing>flow_bikeSourceToOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_orderBike" name="Order bike from dealer">
      <bpmn:incoming>flow_bikeSourceToOrder</bpmn:incoming>
      <bpmn:outgoing>tbpm_flow_orderToAvailability</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="tbpm_gateway_bikeAvailable" name="Bike available?">
      <bpmn:incoming>tbpm_flow_orderToAvailability</bpmn:incoming>
      <bpmn:outgoing>tbpm_flow_availabilityToHandover</bpmn:outgoing>
      <bpmn:outgoing>tbpm_flow_availabilityToClarify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="event_handoverReported" name="Handover reported">
      <bpmn:incoming>tbpm_flow_availabilityToHandover</bpmn:incoming>
      <bpmn:outgoing>flow_handoverToWithdrawalPeriod</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="event_withdrawalPeriodElapsed" name="Await end of withdrawal period">
      <bpmn:incoming>flow_handoverToWithdrawalPeriod</bpmn:incoming>
      <bpmn:outgoing>flow_withdrawalElapsedToActive</bpmn:outgoing>
      <bpmn:timerEventDefinition id="tbpm_timer_withdrawalPeriod">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endEvent_leasingActive" name="Leasing active">
      <bpmn:incoming>flow_withdrawalElapsedToActive</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="userTask_clarifyAlternative" name="Clarify alternative with customer">
      <bpmn:incoming>tbpm_flow_availabilityToClarify</bpmn:incoming>
      <bpmn:outgoing>flow_clarifyToAlternativeGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_alternativeFound" name="Alternative found?">
      <bpmn:incoming>flow_clarifyToAlternativeGateway</bpmn:incoming>
      <bpmn:outgoing>flow_alternativeFound</bpmn:outgoing>
      <bpmn:outgoing>tbpm_flow_alternativeGatewayToCancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="serviceTask_cancelContract" name="Cancel contract">
      <bpmn:incoming>tbpm_flow_alternativeGatewayToCancel</bpmn:incoming>
      <bpmn:outgoing>tbpm_flow_cancelToConfirmation</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="serviceTask_confirmContractCancellation" name="Send cancellation confirmation">
      <bpmn:incoming>tbpm_flow_cancelToConfirmation</bpmn:incoming>
      <bpmn:outgoing>flow_confirmationToContractCancelled</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_contractCancelled" name="Contract cancelled">
      <bpmn:incoming>flow_confirmationToContractCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_requestToCreditCheck" sourceRef="startEvent_leasingRequestReceived" targetRef="businessRuleTask_checkCreditRating" />
    <bpmn:sequenceFlow id="flow_creditCheckToSolvency" sourceRef="businessRuleTask_checkCreditRating" targetRef="gateway_isSolvent" />
    <bpmn:sequenceFlow id="flow_solvent" name="yes" sourceRef="gateway_isSolvent" targetRef="serviceTask_sendContract" />
    <bpmn:sequenceFlow id="flow_notSolvent" name="no" sourceRef="gateway_isSolvent" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_contractSentToAwait" sourceRef="serviceTask_sendContract" targetRef="gateway_awaitSignature" />
    <bpmn:sequenceFlow id="tbpm_flow_awaitToBikeSource" name="yes" sourceRef="gateway_awaitSignature" targetRef="gateway_bikeSourceJoin" />
    <bpmn:sequenceFlow id="tbpm_flow_awaitToRejection" name="no" sourceRef="gateway_awaitSignature" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_rejectionJoined" sourceRef="gateway_rejectionJoin" targetRef="serviceTask_sendRejection" />
    <bpmn:sequenceFlow id="flow_rejectionSent" sourceRef="serviceTask_sendRejection" targetRef="endEvent_applicationRejected" />
    <bpmn:sequenceFlow id="flow_bikeSourceToOrder" sourceRef="gateway_bikeSourceJoin" targetRef="serviceTask_orderBike" />
    <bpmn:sequenceFlow id="tbpm_flow_orderToAvailability" sourceRef="serviceTask_orderBike" targetRef="tbpm_gateway_bikeAvailable" />
    <bpmn:sequenceFlow id="tbpm_flow_availabilityToHandover" name="yes" sourceRef="tbpm_gateway_bikeAvailable" targetRef="event_handoverReported" />
    <bpmn:sequenceFlow id="tbpm_flow_availabilityToClarify" name="no" sourceRef="tbpm_gateway_bikeAvailable" targetRef="userTask_clarifyAlternative" />
    <bpmn:sequenceFlow id="flow_handoverToWithdrawalPeriod" sourceRef="event_handoverReported" targetRef="event_withdrawalPeriodElapsed" />
    <bpmn:sequenceFlow id="flow_withdrawalElapsedToActive" sourceRef="event_withdrawalPeriodElapsed" targetRef="endEvent_leasingActive" />
    <bpmn:sequenceFlow id="flow_clarifyToAlternativeGateway" sourceRef="userTask_clarifyAlternative" targetRef="gateway_alternativeFound" />
    <bpmn:sequenceFlow id="flow_alternativeFound" name="yes" sourceRef="gateway_alternativeFound" targetRef="gateway_bikeSourceJoin" />
    <bpmn:sequenceFlow id="tbpm_flow_alternativeGatewayToCancel" name="no" sourceRef="gateway_alternativeFound" targetRef="serviceTask_cancelContract" />
    <bpmn:sequenceFlow id="tbpm_flow_cancelToConfirmation" sourceRef="serviceTask_cancelContract" targetRef="serviceTask_confirmContractCancellation" />
    <bpmn:sequenceFlow id="flow_confirmationToContractCancelled" sourceRef="serviceTask_confirmContractCancellation" targetRef="endEvent_contractCancelled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="tbpm_diagram_bikeLeasing">
    <bpmndi:BPMNPlane id="tbpm_plane_bikeLeasing" bpmnElement="tbpm_collaboration_bikeLeasing">
      <bpmndi:BPMNShape id="tbpm_participant_bikeLeasing_di" bpmnElement="tbpm_participant_bikeLeasing" isHorizontal="true">
        <dc:Bounds x="120" y="30" width="1520" height="460" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="startEvent_leasingRequestReceived_di" bpmnElement="startEvent_leasingRequestReceived">
        <dc:Bounds x="192" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="170" y="245" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="businessRuleTask_checkCreditRating_di" bpmnElement="businessRuleTask_checkCreditRating">
        <dc:Bounds x="280" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_isSolvent_di" bpmnElement="gateway_isSolvent" isMarkerVisible="true">
        <dc:Bounds x="430" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="433" y="252" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_sendContract_di" bpmnElement="serviceTask_sendContract">
        <dc:Bounds x="530" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tbpm_dataObject_leasingContract_di" bpmnElement="tbpm_dataObject_leasingContract">
        <dc:Bounds x="562" y="300" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="539" y="357" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_awaitSignature_di" bpmnElement="gateway_awaitSignature" isMarkerVisible="true">
        <dc:Bounds x="680" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="662" y="252" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_rejectionJoin_di" bpmnElement="gateway_rejectionJoin" isMarkerVisible="true">
        <dc:Bounds x="680" y="75" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="662" y="52" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_sendRejection_di" bpmnElement="serviceTask_sendRejection">
        <dc:Bounds x="780" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_applicationRejected_di" bpmnElement="endEvent_applicationRejected">
        <dc:Bounds x="932" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="922" y="125" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_bikeSourceJoin_di" bpmnElement="gateway_bikeSourceJoin" isMarkerVisible="true">
        <dc:Bounds x="780" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_orderBike_di" bpmnElement="serviceTask_orderBike">
        <dc:Bounds x="880" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tbpm_gateway_bikeAvailable_di" bpmnElement="tbpm_gateway_bikeAvailable" isMarkerVisible="true">
        <dc:Bounds x="1030" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1016" y="172" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_handoverReported_di" bpmnElement="event_handoverReported">
        <dc:Bounds x="1212" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1203" y="245" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_withdrawalPeriodElapsed_di" bpmnElement="event_withdrawalPeriodElapsed">
        <dc:Bounds x="1382" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1355" y="245" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_leasingActive_di" bpmnElement="endEvent_leasingActive">
        <dc:Bounds x="1555" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1538" y="245" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_clarifyAlternative_di" bpmnElement="userTask_clarifyAlternative">
        <dc:Bounds x="1005" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_alternativeFound_di" bpmnElement="gateway_alternativeFound" isMarkerVisible="true">
        <dc:Bounds x="1155" y="345" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1135" y="322" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_cancelContract_di" bpmnElement="serviceTask_cancelContract">
        <dc:Bounds x="1255" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_confirmContractCancellation_di" bpmnElement="serviceTask_confirmContractCancellation">
        <dc:Bounds x="1405" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_contractCancelled_di" bpmnElement="endEvent_contractCancelled">
        <dc:Bounds x="1555" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1545" y="395" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_requestToCreditCheck_di" bpmnElement="flow_requestToCreditCheck">
        <di:waypoint x="228" y="220" />
        <di:waypoint x="280" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_creditCheckToSolvency_di" bpmnElement="flow_creditCheckToSolvency">
        <di:waypoint x="380" y="220" />
        <di:waypoint x="430" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_solvent_di" bpmnElement="flow_solvent">
        <di:waypoint x="480" y="220" />
        <di:waypoint x="530" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="496" y="202" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notSolvent_di" bpmnElement="flow_notSolvent">
        <di:waypoint x="455" y="195" />
        <di:waypoint x="455" y="100" />
        <di:waypoint x="680" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="462" y="152" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_dataOutput_sendContractToLeasingContract_di" bpmnElement="tbpm_dataOutput_sendContractToLeasingContract">
        <di:waypoint x="580" y="260" />
        <di:waypoint x="580" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_contractSentToAwait_di" bpmnElement="flow_contractSentToAwait">
        <di:waypoint x="630" y="220" />
        <di:waypoint x="680" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_flow_awaitToBikeSource_di" bpmnElement="tbpm_flow_awaitToBikeSource">
        <di:waypoint x="730" y="220" />
        <di:waypoint x="780" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="746" y="202" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_flow_awaitToRejection_di" bpmnElement="tbpm_flow_awaitToRejection">
        <di:waypoint x="705" y="195" />
        <di:waypoint x="705" y="125" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="712" y="152" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rejectionJoined_di" bpmnElement="flow_rejectionJoined">
        <di:waypoint x="730" y="100" />
        <di:waypoint x="780" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rejectionSent_di" bpmnElement="flow_rejectionSent">
        <di:waypoint x="880" y="100" />
        <di:waypoint x="932" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_bikeSourceToOrder_di" bpmnElement="flow_bikeSourceToOrder">
        <di:waypoint x="830" y="220" />
        <di:waypoint x="880" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_flow_orderToAvailability_di" bpmnElement="tbpm_flow_orderToAvailability">
        <di:waypoint x="980" y="220" />
        <di:waypoint x="1030" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_flow_availabilityToHandover_di" bpmnElement="tbpm_flow_availabilityToHandover">
        <di:waypoint x="1080" y="220" />
        <di:waypoint x="1212" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1102" y="202" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_flow_availabilityToClarify_di" bpmnElement="tbpm_flow_availabilityToClarify">
        <di:waypoint x="1055" y="245" />
        <di:waypoint x="1055" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1062" y="280" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_handoverToWithdrawalPeriod_di" bpmnElement="flow_handoverToWithdrawalPeriod">
        <di:waypoint x="1248" y="220" />
        <di:waypoint x="1382" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_withdrawalElapsedToActive_di" bpmnElement="flow_withdrawalElapsedToActive">
        <di:waypoint x="1418" y="220" />
        <di:waypoint x="1555" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_clarifyToAlternativeGateway_di" bpmnElement="flow_clarifyToAlternativeGateway">
        <di:waypoint x="1105" y="370" />
        <di:waypoint x="1155" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_alternativeFound_di" bpmnElement="flow_alternativeFound">
        <di:waypoint x="1180" y="395" />
        <di:waypoint x="1180" y="450" />
        <di:waypoint x="805" y="450" />
        <di:waypoint x="805" y="245" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1187" y="413" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_flow_alternativeGatewayToCancel_di" bpmnElement="tbpm_flow_alternativeGatewayToCancel">
        <di:waypoint x="1205" y="370" />
        <di:waypoint x="1255" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1223" y="352" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tbpm_flow_cancelToConfirmation_di" bpmnElement="tbpm_flow_cancelToConfirmation">
        <di:waypoint x="1355" y="370" />
        <di:waypoint x="1405" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_confirmationToContractCancelled_di" bpmnElement="flow_confirmationToContractCancelled">
        <di:waypoint x="1505" y="370" />
        <di:waypoint x="1555" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
