meta {
  name: Find the process instance of the under-age request
  type: http
  seq: 2
}

get {
  url: {{engineRest}}/history/process-instance?processInstanceBusinessKey={{underAgeId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: length 1
}

vars:post-response {
  underAgeInstanceId: res.body[0].id
}
