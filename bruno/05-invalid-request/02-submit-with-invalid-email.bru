meta {
  name: Submit a request with an invalid email address
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Erik Email",
    "email": "not-an-email",
    "age": 35,
    "monthlyNetIncome": 3500.0,
    "bikeId": "BIKE-900"
  }
}

assert {
  res.status: eq 400
  res.body.title: eq Invalid request
  res.body.detail: eq 'not-an-email' is not a valid email address
}
