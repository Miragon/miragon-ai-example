meta {
  name: Clarify an alternative bike (external completion)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/clarify-alternative
  body: json
  auth: none
}

script:pre-request {
  await pollEngine("/task?processInstanceBusinessKey=" + bru.getVar("applicationId")
    + "&taskDefinitionKey=userTask_clarifyAlternative",
    (b) => Array.isArray(b) && b.length >= 1);
}

body:json {
  {
    "alternativeFound": true,
    "bikeId": "BIKE-900"
  }
}

assert {
  res.status: eq 202
}

docs {
  The domain-routed completion path: this endpoint completes the user task with the
  customer's decision and the chosen bikeId. The re-order reads that variable and
  persists it on the aggregate. 06-alternative-via-tasklist completes the same task the
  way the Tasklist form does.
}
