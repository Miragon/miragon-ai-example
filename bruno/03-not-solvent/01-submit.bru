meta {
  name: Submit leasing request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Nick Notsolvent",
    "email": "nick@example.com",
    "age": 29,
    "monthlyNetIncome": 1200.0,
    "bikeId": "BIKE-800"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  applicationId: res.body.applicationId
}
