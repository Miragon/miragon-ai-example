meta {
  name: Assert the process ended in "Application rejected"
  type: http
  seq: 5
}

get {
  url: {{engineRest}}/history/activity-instance?processInstanceId={{processInstanceId}}&activityId=endEvent_applicationRejected
  body: none
  auth: none
}

script:pre-request {
  await pollEngine("/history/activity-instance?processInstanceId=" + bru.getVar("processInstanceId")
    + "&activityId=endEvent_applicationRejected",
    (b) => Array.isArray(b) && b.length === 1);
}

assert {
  res.status: eq 200
  res.body: length 1
}
