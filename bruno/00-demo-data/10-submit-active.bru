meta {
  name: Submit a case that will become an active lease
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Anna Active",
    "email": "anna@example.com",
    "age": 33,
    "monthlyNetIncome": 3300.0,
    "bikeId": "BIKE-900"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  activeId: res.body.applicationId
}

docs {
  Demo case 4: walks the whole happy path to an active lease.
}
