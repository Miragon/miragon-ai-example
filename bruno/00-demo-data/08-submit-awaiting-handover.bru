meta {
  name: Submit a case that will wait for the handover
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Hank Handover",
    "email": "hank@example.com",
    "age": 51,
    "monthlyNetIncome": 5100.0,
    "bikeId": "BIKE-800"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  awaitingHandoverId: res.body.applicationId
}

docs {
  Demo case 4: the contract is signed and the bike ordered; the case waits for the dealer
  to report the handover (POST /api/bike-leasing/{id}/report-handover).
}
