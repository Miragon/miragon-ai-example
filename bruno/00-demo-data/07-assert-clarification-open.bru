meta {
  name: Assert the case waits on "Clarify alternative with customer"
  type: http
  seq: 7
}

get {
  url: {{engineRest}}/task?processInstanceBusinessKey={{clarifyingId}}&taskDefinitionKey=userTask_clarifyAlternative
  body: none
  auth: none
}

script:pre-request {
  await pollEngine("/task?processInstanceBusinessKey=" + bru.getVar("clarifyingId")
    + "&taskDefinitionKey=userTask_clarifyAlternative",
    (b) => Array.isArray(b) && b.length >= 1);
}

assert {
  res.status: eq 200
  res.body: length 1
  res.body[0].name: eq Clarify alternative with customer
  res.body[0].camundaFormRef.key: eq clarifyAlternativeForm
}
