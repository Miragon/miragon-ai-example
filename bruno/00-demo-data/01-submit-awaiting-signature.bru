meta {
  name: Submit a case that will wait for the signature
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Wendy Waiting",
    "email": "wendy@example.com",
    "age": 42,
    "monthlyNetIncome": 4200.0,
    "bikeId": "BIKE-900"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  awaitingSignatureId: res.body.applicationId
}

docs {
  Demo case 1: the contract is sent and the case waits at the event-based gateway for the
  customer's signature or the 14-day deadline. Nothing else is done with it.
}
