meta {
  name: Withdraw the case during the credit check
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{withdrawnId}}/withdraw
  body: none
  auth: none
}

script:pre-request {
  await pollActivity(bru.getVar("withdrawnId"), "userTask_checkCreditRating");
}

assert {
  res.status: eq 202
}
