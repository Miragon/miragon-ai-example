meta {
  name: Submit a case that will wait for the credit check
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Clara Creditcheck",
    "email": "clara@example.com",
    "age": 42,
    "monthlyNetIncome": 4200.0,
    "bikeId": "BIKE-900"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  awaitingCreditCheckId: res.body.applicationId
}

docs {
  Demo case 1: valid, so it rests on the user task "Check credit rating" until the back office decides.
}
