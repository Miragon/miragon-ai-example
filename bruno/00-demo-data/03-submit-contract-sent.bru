meta {
  name: Submit a case that will wait for the signature
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Carl Contract",
    "email": "carl@example.com",
    "age": 38,
    "monthlyNetIncome": 3800.0,
    "bikeId": "BIKE-800"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  contractSentId: res.body.applicationId
}

docs {
  Demo case 2: solvent, so the contract is sent and the case waits for the customer's signature.
}
