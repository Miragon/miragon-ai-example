meta {
  name: Assert the bike is ordered and the case waits for the handover
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/bike-leasing/{{awaitingHandoverId}}
  body: none
  auth: none
}

script:pre-request {
  await pollEngine("/process-instance?businessKey=" + bru.getVar("awaitingHandoverId")
    + "&activityIdIn=event_handoverReported",
    (b) => Array.isArray(b) && b.length === 1);
}

assert {
  res.status: eq 200
  res.body.status: eq ORDERED
  res.body.orderId: isDefined
}
