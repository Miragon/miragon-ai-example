meta {
  name: Sign the contract of the out-of-stock case
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{clarifyingId}}/sign-contract
  body: none
  auth: none
}

script:pre-request {
  await pollApp("/api/bike-leasing/" + bru.getVar("clarifyingId"),
    (b, s) => s === 200 && b && b.contractId != null);
}

assert {
  res.status: eq 202
}
