meta {
  name: Submit a case for the out-of-stock bike
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Olga Outofstock",
    "email": "olga@example.com",
    "age": 37,
    "monthlyNetIncome": 3800.0,
    "bikeId": "BIKE-OOS"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  clarifyingId: res.body.applicationId
}

docs {
  Demo case 3: after the signature the dealer reports BIKE-OOS as out of stock, so the
  case parks on the user task "Clarify alternative with customer" — open it in the
  Tasklist (/camunda, admin/admin) and complete the form there.
}
