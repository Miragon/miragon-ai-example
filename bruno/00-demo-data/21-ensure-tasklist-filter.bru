meta {
  name: Make sure the Tasklist has the filter "All tasks"
  type: http
  seq: 21
}

get {
  url: {{engineRest}}/filter?resourceType=Task&name=All%20tasks
  body: none
  auth: none
}

script:pre-request {
  // A fresh engine has no task filter, so the Tasklist and the webclient show "No filter
  // available" and hide every task. Create "All tasks" once; a second run finds it and skips.
  const axios = require('axios');
  const engineRest = bru.getEnvVar('engineRest');
  const existing = await axios.get(engineRest + '/filter/count',
    { params: { resourceType: 'Task', name: 'All tasks' } });
  if (existing.data.count === 0) {
    await axios.post(engineRest + '/filter/create', {
      resourceType: 'Task',
      name: 'All tasks',
      owner: 'admin',
      query: {},
      properties: { priority: -10 },
    });
  }
}

assert {
  res.status: eq 200
  res.body: length 1
  res.body[0].name: eq All tasks
}

docs {
  Not a demo case: the Tasklist filter "All tasks" (owner admin) that lets the Tasklist and the
  webclient show the open tasks "Check credit rating" and "Reverse application". Safe to run again:
  the filter is created only if it does not exist yet. Resetting the database deletes it.
}
