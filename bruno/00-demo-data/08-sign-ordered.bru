meta {
  name: Sign the contract of the handover case
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{orderedId}}/sign-contract
  body: none
  auth: none
}

script:pre-request {
  await pollActivity(bru.getVar("orderedId"), "event_contractSigned");
}

assert {
  res.status: eq 202
}
