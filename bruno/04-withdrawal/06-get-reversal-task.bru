meta {
  name: Find the open reversal in the back-office tasks
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/tasks
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar("applicationId");
  await pollApp("/api/tasks",
    (b) => Array.isArray(b) && b.some((t) => t.application.applicationId === id && t.type === "REVERSAL"));
}

assert {
  res.status: eq 200
}

tests {
  test("the withdrawn application waits for its reversal", function () {
    const id = bru.getVar("applicationId");
    const tasks = res.getBody().filter((t) => t.application.applicationId === id);
    expect(tasks).to.have.length(1);
    expect(tasks[0].type).to.equal("REVERSAL");
    expect(tasks[0].application.status).to.equal("WITHDRAWN");
  });
}
