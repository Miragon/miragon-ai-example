meta {
  name: Complete a reversal that is not open
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/reversal
  body: none
  auth: none
}

assert {
  res.status: eq 409
  res.body.title: eq Action not available in the current state
}

docs {
  The reversal is done and the process has ended, so there is no open task to complete.
}
