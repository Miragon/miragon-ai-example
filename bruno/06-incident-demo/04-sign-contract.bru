meta {
  name: Sign the contract to reach the bike order
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/sign-contract
  body: none
  auth: none
}

script:pre-request {
  await pollActivity(bru.getVar("applicationId"), "event_contractSigned");
}

assert {
  res.status: eq 202
}
