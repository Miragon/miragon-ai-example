meta {
  name: Complete the credit check (solvent)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/credit-check
  body: json
  auth: none
}

body:json {
  {
    "solvent": true
  }
}

script:pre-request {
  await pollActivity(bru.getVar("applicationId"), "userTask_checkCreditRating");
}

assert {
  res.status: eq 202
}
